<Project>
  <!-- Общие настройки для всех проектов в src/ -->
  <PropertyGroup>
    <!-- .NET 10: веб-приложению нужны возможности Blazor из .NET 10 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
