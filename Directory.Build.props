<Project>
  <!-- Общие настройки для всех проектов в src/ -->
  <PropertyGroup>
    <!-- Если установлен .NET 8 SDK, замените на net8.0 (только здесь) -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
