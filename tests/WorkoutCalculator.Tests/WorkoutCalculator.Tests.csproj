<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты ядра и модели тела. TargetFramework берётся из Directory.Build.props -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>WorkoutCalculator.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Данные MakeHuman (CC0) лежат в приложении; тестам нужна их копия рядом со сборкой -->
  <ItemGroup>
    <None Include="..\..\src\WorkoutCalculator.Body3D\wwwroot\data\makehuman-hm08.bin" Link="data\makehuman-hm08.bin"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WorkoutCalculator.Core\WorkoutCalculator.Core.csproj" />
    <ProjectReference Include="..\..\src\WorkoutCalculator.BodyModel\WorkoutCalculator.BodyModel.csproj" />
  </ItemGroup>

</Project>
