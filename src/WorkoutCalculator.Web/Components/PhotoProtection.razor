@* Защита фото: PIN-код (снимки шифруются на устройстве, photos.js), размытие и водяной знак. Общая для «Профиля»
   и прежней вкладки «Фото» (?classic=1). Состояние PIN-кода — у родителя: он перечитывает его по OnChange и
   по блокировке (PhotoStore.OnLock — один обработчик на страницу, поэтому его ставит родитель). *@
@using System.Runtime.InteropServices.JavaScript

<div class="card">
    <div class="card-title">
        Защита фото
        @if (Status.Enabled)
        {
            <span class="badge">PIN</span>
        }
    </div>
    @if (!Status.Enabled)
    {
        <div class="note" style="margin-bottom: 10px">
            PIN-код шифрует снимки и превью на этом устройстве (AES-256, ключ — из PIN-кода). Без него их не
            открыть ни в приложении, ни в данных браузера. Снимки закрываются после перезагрузки, кнопкой и через
            2&nbsp;минуты в фоне. Забудете PIN-код — снимки не восстановить, только из резервной копии.
        </div>
    }
    else
    {
        <div class="note" style="margin-bottom: 10px">
            Снимки и превью зашифрованы. @(Status.Unlocked
                ? "Сейчас открыты: закроются после перезагрузки, кнопкой или через 2 минуты в фоне."
                : UnlockHere ? "Сейчас закрыты." : "Сейчас закрыты — PIN-код вводится вверху вкладки.")
            Даты, вес и итоги разбора не шифруются — по ним строится модель.
        </div>
    }
    @if (Status.Locked && UnlockHere)
    {
        <form class="file-row" @onsubmit="Unlock">
            <input class="pin-input" type="password" inputmode="numeric" autocomplete="off" maxlength="8"
                   aria-label="PIN-код" placeholder="PIN-код" @bind="_pinA" @bind:event="oninput" />
            <button class="btn primary" type="submit" disabled="@(_busy || _pinA.Length < 4)">@(_busy ? "Проверяю…" : "Открыть снимки")</button>
        </form>
    }
    else if (_mode == Mode.Enable)
    {
        <form @onsubmit="EnablePin">
            <div class="file-row">
                <input class="pin-input" type="password" inputmode="numeric" autocomplete="new-password" maxlength="8"
                       aria-label="Новый PIN-код" placeholder="PIN-код" @bind="_pinA" @bind:event="oninput" />
                <input class="pin-input" type="password" inputmode="numeric" autocomplete="new-password" maxlength="8"
                       aria-label="PIN-код ещё раз" placeholder="ещё раз" @bind="_pinB" @bind:event="oninput" />
            </div>
            <div class="confirm">
                <button class="btn primary" type="submit" disabled="@(_busy || _pinA.Length < 4 || _pinB.Length < 4)">
                    @(_busy ? "Шифрую снимки…" : "Включить")
                </button>
                <button class="btn-link muted" type="button" @onclick="() => Start(Mode.None)">Отмена</button>
            </div>
            <div class="note" style="margin-top: 6px">От 4 до 8 цифр.</div>
        </form>
    }
    else if (_mode == Mode.Disable)
    {
        <form @onsubmit="DisablePin">
            <div class="file-row">
                <input class="pin-input" type="password" inputmode="numeric" autocomplete="off" maxlength="8"
                       aria-label="PIN-код" placeholder="PIN-код" @bind="_pinA" @bind:event="oninput" />
                <button class="btn" type="submit" disabled="@(_busy || _pinA.Length < 4)">@(_busy ? "Расшифровываю…" : "Снять защиту")</button>
                <button class="btn-link muted" type="button" @onclick="() => Start(Mode.None)">Отмена</button>
            </div>
        </form>
    }
    else if (!Status.Enabled && !_secure)
    {
        <div class="hint">
            PIN-код работает только на сайте по HTTPS: браузер не даёт шифрование странице, открытой по
            обычному http (например, с компьютера по локальной сети). Откройте опубликованную версию.
        </div>
    }
    else if (!Status.Enabled)
    {
        <button class="btn" disabled="@_busy" @onclick="() => Start(Mode.Enable)">Установить PIN-код</button>
    }
    else if (Status.Unlocked)
    {
        <div class="file-row">
            <button class="btn" @onclick="Lock">Закрыть снимки</button>
            <button class="btn-link muted" @onclick="() => Start(Mode.Disable)">Снять защиту</button>
        </div>
    }
    @if (_message is not null)
    {
        <div class="@(_error ? "hint" : "note")" role="@(_error ? "alert" : null)" style="margin-top: 10px">@_message</div>
    }
    <div class="privacy-options">
        <label class="check">
            <input type="checkbox" checked="@Privacy.Blur" @onchange="e => SetPrivacy(p => p.Blur = e.Value is true)" />
            Размывать снимки, пока не нажмёте на них
        </label>
        <label class="check">
            <input type="checkbox" checked="@Privacy.Watermark" @onchange="e => SetPrivacy(p => p.Watermark = e.Value is true)" />
            Водяной знак «@WatermarkText» поверх снимков
        </label>
    </div>
    <div class="note" style="margin-top: 8px">
        Запретить снимок экрана веб-страница не может — водяной знак останется на нём и напомнит, чьё это фото.
        Пока приложение свёрнуто, снимки размыты и в переключателе приложений не видны. PIN-код защищает от
        случайного взгляда и чужих рук, но не от взлома устройства — поэтому лучше ещё и блокировка самого телефона.
    </div>
</div>

@code {
    public const string WatermarkText = "личное фото · не пересылать";

    [Parameter, EditorRequired] public PinStatus Status { get; set; } = default!;
    /// <summary>Настройки размытия и водяного знака — объект родителя: меняется на месте и сохраняется.</summary>
    [Parameter, EditorRequired] public PhotoPrivacy Privacy { get; set; } = default!;
    /// <summary>Закрытые снимки открываются здесь же; false — у родителя своё поле PIN-кода.</summary>
    [Parameter] public bool UnlockHere { get; set; } = true;
    /// <summary>PIN-код установлен, снят или введён, изменились настройки — родитель перечитывает состояние.</summary>
    [Parameter] public EventCallback OnChange { get; set; }

    private enum Mode { None, Enable, Disable }

    private Mode _mode;
    private string _pinA = "", _pinB = "";
    private string? _message;
    private bool _error, _busy;
    /// <summary>HTTPS или localhost: иначе в браузере нет шифрования.</summary>
    private readonly bool _secure = BrowserStorage.IsSecure();

    private void Start(Mode mode)
    {
        _mode = mode;
        _pinA = _pinB = "";
        _message = null;
    }

    private void Show(string message, bool error = false)
    {
        _message = message;
        _error = error;
    }

    private static bool ValidPin(string pin) => pin.Length is >= 4 and <= 8 && pin.All(char.IsAsciiDigit);

    private async Task EnablePin()
    {
        if (!ValidPin(_pinA))
        {
            Show("PIN-код — от 4 до 8 цифр.", error: true);
            return;
        }
        if (_pinA != _pinB)
        {
            Show("PIN-коды не совпадают.", error: true);
            return;
        }
        await Run(async () =>
        {
            await PhotoStore.EnablePin(_pinA);
            Start(Mode.None);
            Show("PIN-код установлен: снимки зашифрованы. Запомните его — без PIN-кода снимки не восстановить.");
        });
    }

    private Task DisablePin() => Run(async () =>
    {
        await PhotoStore.DisablePin(_pinA);
        Start(Mode.None);
        Show("Защита снята: снимки хранятся без шифрования.");
    });

    private Task Unlock() => Run(async () =>
    {
        await PhotoStore.Unlock(_pinA);
        Start(Mode.None);
    });

    /// <summary>Закрыть снимки: дальше — через обработчик блокировки у родителя (PhotoStore.OnLock).</summary>
    private void Lock()
    {
        _message = null;
        PhotoStore.Lock();
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
            await OnChange.InvokeAsync();
        }
        catch (JSException e)
        {
            _pinA = _pinB = "";
            Show(e.Message.StartsWith("Error: ", StringComparison.Ordinal) ? e.Message[7..] : e.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetPrivacy(Action<PhotoPrivacy> change)
    {
        change(Privacy);
        ProfileStorage.SavePrivacy(Privacy);
        await OnChange.InvokeAsync();
    }
}
