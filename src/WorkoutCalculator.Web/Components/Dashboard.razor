@using WorkoutCalculator.BodyModel.History
@using WorkoutCalculator.Strength
<section class="card dashboard" aria-label="Обзор">
    <p class="eyebrow">Ваше тело</p><h1>Модель</h1>
    <div class="dashboard-grid">
        <div><small>Последний измеренный вес</small><strong>@(Fact?.WeightKg is { } kg ? Fmt.N(kg, 1) + " кг" : "Нет данных")</strong></div>
        <div><small>С предыдущего замера</small><strong>@Delta</strong></div>
        <div><small>Последний замер</small><strong>@(Fact?.Date.ToString("dd.MM.yyyy") ?? "Пока нет")</strong></div>
        <div><small>Талия · записанное значение</small><strong>@(Fact?.Measurements.GetValueOrDefault(Girth.Waist) is {} waist ? Fmt.N(waist.Cm,1)+" см" : "Нет данных")</strong></div>
    </div>
    <p>Цель: <b>@Goal</b></p>
    <p class="note">3D показывает приближённую форму. Измеренные показатели и визуальные оценки хранятся раздельно.</p>
</section>
@code {
    [Parameter] public BodySnapshot? Fact { get; set; }
    [Parameter] public IReadOnlyList<BodySnapshot> Facts { get; set; } = [];
    [Parameter] public IReadOnlyList<LoggedWorkout> Cardio { get; set; } = [];
    [Parameter, EditorRequired] public StrengthJournalState Strength { get; set; } = default!;
    [Parameter] public string Goal { get; set; } = "";
    [Parameter, EditorRequired] public SavedHypothesis Plan { get; set; } = default!;
    [Parameter, EditorRequired] public PersonalizedForecastState Calibration { get; set; } = default!;
    private DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private DateOnly Monday => StrengthAggregation.MondayOf(Today);
    private string LastWorkout => Cardio.Select(w => w.Date).Concat(Strength.Sessions.Select(s => s.Date)).Where(d => d <= Today).OrderDescending().Select(d => d.ToString("dd.MM.yyyy")).FirstOrDefault() ?? "Пока нет";
    private string Delta {
        get {
            if (Fact?.WeightKg is not { } now) return "Нет пары замеров";
            var old = Facts.Where(f => f.Id != Fact.Id && f.Date <= Fact.Date && f.WeightKg.HasValue).OrderBy(f => f.Date).LastOrDefault();
            return old?.WeightKg is { } kg ? Fmt.Signed(now - kg, 1) + " кг" : "Нет пары замеров";
        }
    }
}
