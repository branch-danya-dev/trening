@using WorkoutCalculator.BodyModel.History
<section class="onboarding" aria-label="Первый запуск">
    <p class="eyebrow">@(Draft.Step == 0 ? "Профиль" : "Создать аватар") · шаг @(Draft.Step + 1) из 8</p>
    <h1>@Titles[Math.Clamp(Draft.Step, 0, 7)]</h1>
    <p>Данные остаются на устройстве. Заполните известное; необязательные поля можно пропустить.</p>
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (Draft.Step == 0)
    {
        <div class="form-grid two">
            <label>Пол<select class="select" aria-label="Пол при настройке" @bind="Draft.Facts.Sex" @bind:after="Persist"><option value="">Выберите</option><option value="Male">Мужской</option><option value="Female">Женский</option></select></label>
            <label>Дата рождения<input type="date" aria-label="Дата рождения" value="@Draft.Preferences.BirthDate" @onchange="BirthChanged" /></label>
            <label>Рост, см<input inputmode="decimal" aria-label="Рост при настройке" @bind="Draft.Facts.Height" @bind:event="oninput" @bind:after="Persist" /></label>
            <label>Вес, кг<input inputmode="decimal" aria-label="Вес при настройке" @bind="Draft.Facts.Weight" @bind:event="oninput" @bind:after="Persist" /></label>
        </div>
        <details><summary>У меня есть резервная копия</summary><BackupPanel /></details>
    }
    else if (Draft.Step == 1)
    {
        <p>Нажмите на поле — лента на 3D покажет место замера. Все обхваты необязательны.</p>
        <div class="form-grid two">
        @foreach (var g in Enum.GetValues<Girth>())
        {
            <label>@BodyProfile.GirthName(g), см<input inputmode="decimal" aria-label="@(BodyProfile.GirthName(g) + " при настройке")" @bind="Draft.Facts.Girths[g]" @bind:event="oninput" @bind:after="Persist" @onfocus="() => OnHighlight.InvokeAsync(g)" @onblur="() => OnHighlight.InvokeAsync((Girth?)null)" /></label>
        }
        </div>
    }
    else if (Draft.Step == 2)
    {
        <label>Известный процент жира<input inputmode="decimal" aria-label="Жир при настройке" @bind="Draft.Facts.BodyFat" @bind:event="oninput" @bind:after="Persist" /></label>
        <button class="btn" @onclick="UnknownFat">Не знаю</button>
        <p class="note">Если оставить пустым, для рисунка используется условная оценка. В историю измерений она не попадёт.</p>
    }
    else if (Draft.Step == 3)
    {
        <p>Фото спереди и сбоку необязательны. Фото — источник оценки формы, а не измерение тела. Фото со спины пока не используется: текущий анализ поддерживает два ракурса.</p>
        @if (Draft.PhotoNotice is not null) { <p role="status">@Draft.PhotoNotice</p> }
        <details><summary>Добавить фото сейчас</summary><PhotosPanel Profile="Preview" Model="Model" RevisionManaged="true" OnAvatarPhoto="OnPhoto" /></details>
        <button class="btn" @onclick="Next">Пропустить фото</button>
    }
    else if (Draft.Step == 4)
    {
        <label>Моя цель<select class="select" aria-label="Моя цель" @bind="Draft.Preferences.Goal" @bind:after="Persist">
            @foreach (var goal in Goals) { <option>@goal</option> }
        </select></label>
        <p>Цель задаёт начальные настройки плана. Их можно изменить в разделе «План».</p>
    }
    else if (Draft.Step == 5)
    {
        <p>Будет создана первая запись за @Draft.Facts.Date: вес @Draft.Facts.Weight кг, рост @Draft.Facts.Height см, обхватов @Draft.Facts.Girths.Count(x => !string.IsNullOrWhiteSpace(x.Value)).</p>
        <p>Жир: @(string.IsNullOrWhiteSpace(Draft.Facts.BodyFat) ? "не измерен" : Draft.Facts.BodyFat + " %"). Пустые поля останутся пустыми.</p>
        <label class="check"><input type="checkbox" @bind="_confirmed" /> Подтверждаю введённые факты</label>
    }
    else { @if (Draft.PhotoNotice is not null) { <p role="status">@Draft.PhotoNotice</p> } @ChildContent }
    <div class="history-actions">
        @if (Draft.Step > 0 && Draft.Step != 6) { <button class="btn" @onclick="Back">Назад</button> }
        @if (Draft.Step < 5 || Draft.Step == 6) { <button class="btn primary" disabled="@Busy" @onclick="Next">@(Draft.Step == 6 ? "Проверить аватар" : "Далее")</button> }
        else if (Draft.Step == 5) { <button class="btn primary" disabled="@(!_confirmed || Busy || Model is null)" @onclick="Finish">Создать 3D аватар</button> }
    </div>
    <small>Черновик сохраняется после изменения поля и каждого шага.</small>
    @if (Draft.Step >= 6) { <details><summary>Резервная копия настройки</summary><BackupPanel /></details> }
</section>

@code {
    [Parameter, EditorRequired] public OnboardingDraft Draft { get; set; } = default!;
    [Parameter] public WorkoutCalculator.BodyModel.MakeHuman.MakeHumanModel? Model { get; set; }
    [Parameter] public EventCallback<BodyProfile> OnPreview { get; set; }
    [Parameter] public EventCallback<Girth?> OnHighlight { get; set; }
    [Parameter] public EventCallback OnFinish { get; set; }
    [Parameter] public EventCallback<PhotoSession> OnPhoto { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Busy { get; set; }
    private string? _error;
    private bool _confirmed;
    private static readonly string[] Titles = ["Познакомимся", "Замеры тела", "Процент жира", "Фото", "Ваша цель", "Подтвердите факты", "Ваша форма", "Проверка и фиксация"];
    public static readonly string[] Goals = ["Похудение", "Поддержание", "Набор", "Улучшение формы и силы"];
    private BodyProfile Preview { get { try { return SnapshotVisuals.Build(Draft.Build()).Profile; } catch { return BodyDefaults.Default(); } } }
    private async Task Persist() { try { ProductStorage.Save(Draft); _error = null; if (Draft.Step > 0 && Draft.Step < 6) await OnPreview.InvokeAsync(Preview); } catch { _error = "Не удалось сохранить черновик. Проверьте доступ и свободное место в хранилище браузера."; } }
    private async Task BirthChanged(ChangeEventArgs e) { Draft.Preferences.BirthDate = e.Value?.ToString() ?? ""; await Persist(); }
    private async Task Next() { try { Draft.Build(); Draft.Step = Math.Min(7, Draft.Step + 1); await Persist(); } catch (ArgumentException e) { _error = e.Message; } }
    private async Task Back() { Draft.Step = Math.Max(0, Draft.Step - 1); await Persist(); }
    private async Task UnknownFat() { Draft.Facts.BodyFat = ""; await Persist(); }
    private async Task Finish() { try { Draft.Build(); await OnFinish.InvokeAsync(); } catch (Exception e) { _error = "Настройка не завершена. " + e.Message; } }
}
