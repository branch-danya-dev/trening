@* Вкладка «Гипотеза»: питание и тренировки на N недель → прогноз веса, % жира и обхватов.
   Гипотез может быть несколько: редактор и 3D показывают выбранную, сравнение — все. *@

<div class="card">
    <div class="card-title">
        Сценарии питания и тренировок
        <span class="title-note">@Hypotheses.Items.Count из @StoredHypotheses.Max</span>
    </div>
    <div class="chips" role="radiogroup" aria-label="Выбранный сценарий">
        @foreach (var h in Hypotheses.Items)
        {
            int slot = h.Slot;
            bool on = slot == Hypotheses.Selected;
            <button class="chip series-@slot @Css.On(on)" role="radio" aria-checked="@(on ? "true" : "false")"
                    @onclick="() => Select(slot)"><i class="key"></i><span class="chip-name">@h.Name</span></button>
        }
        <button class="chip add" disabled="@(!Hypotheses.CanAdd)" @onclick="Add"
                title="@(Hypotheses.CanAdd ? "Новый сценарий — копия выбранного" : $"Не больше {StoredHypotheses.Max} сценариев: удалите ненужную")">
            + Копия
        </button>
    </div>
    <div class="field-row" style="margin-top: 12px">
        <label for="hypothesis-name">Название</label>
        <input id="hypothesis-name" class="text-input" maxlength="@StoredHypotheses.MaxNameLength" @key="(Hypotheses.Selected, _nameVersion)"
               value="@Hypotheses.Current.Name" @onchange="Rename" />
    </div>
    @if (Hypotheses.Items.Count > 1)
    {
        <div class="confirm">
            @if (_confirmDelete == Hypotheses.Selected)
            {
                <span>Удалить «@Hypotheses.Current.Name»?</span>
                <button class="btn-link" @onclick="Remove">Удалить</button>
                <button class="btn-link muted" @onclick="() => _confirmDelete = null">Отмена</button>
            }
            else
            {
                <button class="btn-link muted" @onclick="() => _confirmDelete = Hypotheses.Selected">Удалить сценарий</button>
            }
        </div>
    }
    <div class="note" style="margin-top: 8px">
        Ниже и в 3D — выбранный сценарий, изменения сразу сохраняются в этом браузере.
        @(Hypotheses.Items.Count > 1 ? "Сравнение всех — под итогом." : "Чтобы сравнить варианты, сделайте копию и измените её.")
    </div>
</div>

<div class="card">
    <div class="card-title">План</div>
    <ParamSlider Label="Срок" Unit="нед." Min="1" Max="52" Step="1"
                 Value="Hypothesis.Weeks" ValueChanged="v => Change(h => h.Weeks = (int)v)" />
    <ParamSlider Label="Питание" Unit="ккал/д" Min="1000" Max="5000" Step="10"
                 Hint="@($"Поддержание сейчас ≈ {Fmt.N(Maintenance.Total)} ккал в день")"
                 Value="Hypothesis.IntakeKcalPerDay" ValueChanged="v => Change(h => h.IntakeKcalPerDay = v)" />
    <button class="btn-link" @onclick="SetMaintenance">Поставить поддержание</button>
    <NutritionInputs @key="Hypotheses.Selected" Plan="Hypothesis" OnApply="Change" />
    @if (_nutritionError is not null) { <p class="error" role="alert">@_nutritionError</p> }
    <ParamSlider Label="Бытовая активность" Unit="× БМР" Min="1.1" Max="1.9" Step="0.05"
                 Hint="@ActivityHint(Hypothesis.ActivityFactor)"
                 Value="Hypothesis.ActivityFactor" ValueChanged="v => Change(h => h.ActivityFactor = v)" />
    <ParamSlider Label="Целевой вес" Unit="кг" Min="40" Max="180" Step="0.5" Disabled="Hypothesis.TargetWeightKg is null"
                 Hint="Необязательно: нужен для проверки, достижима ли цель"
                 Value="Hypothesis.TargetWeightKg ?? Profile.WeightKg" ValueChanged="v => Change(h => h.TargetWeightKg = v)" />
    <label class="check" style="margin-top: 6px">
        <input type="checkbox" checked="@(Hypothesis.TargetWeightKg is not null)"
               @onchange="e => Change(h => h.TargetWeightKg = e.Value is true ? Math.Round(Profile.WeightKg) : null)" />
        Указать цель
    </label>
</div>

<div class="card">
    <div class="card-title">Кардио</div>
    <div class="field-row">
        <label for="cardio-kind">Тренировка</label>
        <select id="cardio-kind" class="select" value="@Hypothesis.CardioKind" @onchange="OnCardioKind">
            <option value="-1">Нет</option>
            <option value="0">Ходьба на дорожке</option>
            <option value="1">Бег на дорожке</option>
            <option value="2">Ходьба на улице</option>
            <option value="3">Бег на улице</option>
        </select>
    </div>
    @if (Hypothesis.CardioKind >= 0)
    {
        <div style="margin-top: 12px">
            <ParamSlider Label="Раз в неделю" Min="1" Max="14" Step="1"
                         Value="Hypothesis.CardioPerWeek" ValueChanged="v => Change(h => h.CardioPerWeek = (int)v)" />
            @if (Hypothesis.CardioKind < 2)
            {
                <ParamSlider Label="Длительность" Unit="мин" Min="10" Max="180" Step="1"
                             Value="Hypothesis.CardioMinutes" ValueChanged="v => Change(h => h.CardioMinutes = v)" />
                <ParamSlider Label="Скорость" Unit="км/ч" Min="2" Max="20" Step="0.1"
                             Value="Hypothesis.CardioSpeedKmh" ValueChanged="v => Change(h => h.CardioSpeedKmh = v)" />
                <ParamSlider Label="Уклон" Unit="%" Min="0" Max="15" Step="0.5"
                             Value="Hypothesis.CardioInclinePercent" ValueChanged="v => Change(h => h.CardioInclinePercent = v)" />
            }
            else
            {
                <ParamSlider Label="Дистанция" Unit="км" Min="1" Max="42" Step="0.1"
                             Value="Hypothesis.CardioDistanceKm" ValueChanged="v => Change(h => h.CardioDistanceKm = v)" />
                <ParamSlider Label="Время" Unit="мин" Min="10" Max="300" Step="1"
                             Value="Hypothesis.CardioMinutes" ValueChanged="v => Change(h => h.CardioMinutes = v)" />
                <ParamSlider Label="Набор высоты" Unit="м" Min="0" Max="2000" Step="10"
                             Value="Hypothesis.CardioElevationGainM" ValueChanged="v => Change(h => h.CardioElevationGainM = v)" />
                <div class="field-row" style="margin-top: 12px">
                    <label for="cardio-terrain">Покрытие</label>
                    <select id="cardio-terrain" class="select" value="@((int)Hypothesis.CardioTerrain)" @onchange="OnTerrain">
                        <option value="0">Асфальт / плитка</option>
                        <option value="1">Грунтовка</option>
                        <option value="2">Трава</option>
                        <option value="3">Песок</option>
                    </select>
                </div>
            }
            <ParamSlider Label="Средний пульс" Unit="уд/мин" Min="80" Max="200" Step="1" Disabled="Hypothesis.CardioAvgHr is null"
                         Hint="Необязательно: добавляет оценку по пульсу (Кейтел)"
                         Value="Hypothesis.CardioAvgHr ?? 130" ValueChanged="v => Change(h => h.CardioAvgHr = (int)v)" />
            <label class="check" style="margin-top: 6px">
                <input type="checkbox" checked="@(Hypothesis.CardioAvgHr is not null)"
                       @onchange="e => Change(h => h.CardioAvgHr = e.Value is true ? 130 : null)" />
                Указать пульс
            </label>
            <div class="volume-line">
                За тренировку ≈&nbsp;@Fmt.N(Maintenance.CardioPerSession) ккал сверх базового обмена (калькулятор тренировок)
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-title">Силовые</div>
    <label class="check">
        <input type="checkbox" checked="@Hypothesis.Strength" @onchange="e => Change(h => h.Strength = e.Value is true)" />
        Есть силовые тренировки
    </label>
    @if (Hypothesis.Strength)
    {
        <div style="margin-top: 12px">
            @if (Hypothesis.StrengthProgram is null)
            {
                <ParamSlider Label="Раз в неделю" Min="1" Max="7" Step="1"
                             Value="Hypothesis.StrengthPerWeek" ValueChanged="v => Change(h => h.StrengthPerWeek = (int)v)" />
            }
            else
            {
                <p class="note">@Hypothesis.StrengthProgram.SessionsPerWeek занятий в неделю. Частота задаётся в программе ниже.</p>
            }
            <div class="field-row" style="margin-top: 12px">
                <span>Стаж</span>
                <div class="seg">
                    @foreach (var (exp, name) in Experiences)
                    {
                        <button class="@Css.On(Hypothesis.Experience == exp)" @onclick="() => Change(h => h.Experience = exp)">@name</button>
                    }
                </div>
            </div>
            <div class="volume-line">
                За тренировку ≈&nbsp;@Fmt.N(Maintenance.StrengthPerSession) ккал (3,5 MET × 1 ч).
                Потолок прироста безжировой ткани ≈&nbsp;@Fmt.N(MonthlyCeilingKg, 2) кг в месяц.
            </div>
        </div>
    }
</div>

@if (Hypothesis.Strength)
{
    <StrengthProgramEditor @key="Hypotheses.Selected" Program="Hypothesis.StrengthProgram" OnChange="p => Change(h => { h.StrengthProgram = p; if (p is not null) h.StrengthPerWeek = p.SessionsPerWeek; })" />
}
<MuscleForecastPanel Snapshot="Personalized.Display" />
@if (Forecast is not null)
{
    var f = Forecast;
    <ForecastAccuracy State="Personalized" OnSave="OnSaveForecast" OnNew="OnNewForecast" OnSelect="OnSelectForecast" />
    @if (Hypotheses.Items.Any(h => h.Plan.StartDate is not null && h.Plan.StartProfile is not null))
    {
        <div class="card">
            <p class="note">Есть планы из прежней версии. Их исходные данные сохранены. Можно перенести их в историю как восстановленные прогнозы;
                они не участвуют в обучении и backtest, поскольку прежние расчётные точки не сохранялись.</p>
            <button class="btn" @onclick="OnImportLegacy">Перенести прежние планы в историю</button>
        </div>
    }
    <div class="card">
        <div class="card-title">Через @f.Weeks[^1].Week нед. @SelectedNote</div>
        <div class="summary">
            Вес <b>@Fmt.N(f.Start.WeightKg, 1) → @Fmt.N(f.End.WeightKg, 1) кг</b> (@Fmt.Signed(f.WeightChangeKg)),
            жир <b>@Fmt.N(f.Start.BodyFatPercent, 1) → @Fmt.N(f.End.BodyFatPercent, 1)&nbsp;%</b>.
        </div>
        <div class="volume-line">
            Жир @Fmt.Signed(f.FatChangeKg) кг, безжировая ткань @Fmt.Signed(f.LeanChangeKg) кг,
            вода и гликоген @Fmt.Signed(f.WaterChangeKg) кг.
            Средний баланс @Fmt.Signed(Selected!.AverageBalanceKcalPerDay, 0) ккал в день.
            @if (Math.Abs(f.AdaptationKcalPerDay) >= 1)
            {
                <text>Обмен подстроится под питание: к концу срока расход на @Fmt.N(Math.Abs(f.AdaptationKcalPerDay)) ккал в день
                @(f.AdaptationKcalPerDay < 0 ? "ниже" : "выше") (модель Холла).</text>
            }
        </div>
        @if (f.Warnings.Count > 0)
        {
            <div class="hints" style="margin-top: 10px">
                @foreach (var w in f.Warnings)
                {
                    <div class="hint">@w</div>
                }
            </div>
        }
        <div class="disclaimer" style="margin-top: 10px">
            Это грубая оценка, а не обещание. Обмен веществ у всех подстраивается по-разному, а колебания воды,
            гормоны и реальная приверженность плану в модели не учтены.
        </div>
    </div>

    @if (Forecasts.Count > 1 && Personalized.Selected is null)
    {
        var now = f.Start;
        <div class="card">
            <div class="card-title">Сравнение сценариев</div>
            <div class="table-scroll">
                <table class="changes compare">
                    <thead>
                        <tr>
                            <th></th>
                            <th class="now">Сейчас</th>
                            @foreach (var hf in Forecasts)
                            {
                                int slot = hf.Hypothesis.Slot;
                                bool on = slot == Hypotheses.Selected;
                                <th class="@SelClass(hf)">
                                    <button class="col-btn series-@slot" aria-pressed="@(on ? "true" : "false")" title="Показать в редакторе и в 3D"
                                            @onclick="() => Select(slot)"><i class="key"></i>@hf.Hypothesis.Name</button>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @Group("План")
                        @PlanRow("Срок, нед.", hf => Fmt.N(hf.Forecast.Weeks[^1].Week))
                        @PlanRow("Питание, ккал/д", hf => Fmt.N(hf.Hypothesis.Plan.IntakeKcalPerDay))
                        @PlanRow("Кардио, раз/нед.", hf => hf.Hypothesis.Plan.CardioKind < 0 ? "—" : Fmt.N(hf.Hypothesis.Plan.CardioPerWeek))
                        @PlanRow("Силовые, раз/нед.", hf => hf.Hypothesis.Plan.Strength ? Fmt.N(hf.Hypothesis.Plan.StrengthPerWeek) : "—")
                        @PlanRow("Ср. баланс, ккал/д", hf => Fmt.Signed(hf.AverageBalanceKcalPerDay, 0))
                        @Group("К концу срока")
                        @ResultRow("Вес, кг", now.WeightKg, hf => hf.Forecast.End.WeightKg, 1)
                        @ResultRow("Жир, %", now.BodyFatPercent, hf => hf.Forecast.End.BodyFatPercent, 1)
                        @ResultRow("Жир, кг", f.Weeks[0].FatMassKg, hf => hf.Forecast.Weeks[^1].FatMassKg, 1)
                        @ResultRow("Безжир. ткань, кг", f.Weeks[0].LeanMassKg, hf => hf.Forecast.Weeks[^1].LeanMassKg, 1)
                        @foreach (Girth g in ShownGirths(now))
                        {
                            @ResultRow(ShortGirthName(g) + ", см", now.GetGirth(g), hf => hf.Forecast.End.GetGirth(g), 1)
                        }
                        @PlanRow("Предупреждения", hf => hf.Forecast.Warnings.Count == 0 ? "—" : Fmt.N(hf.Forecast.Warnings.Count))
                    </tbody>
                </table>
            </div>
            <div class="note" style="margin-top: 8px">
                Все сценарии считаются от текущих параметров. Текст предупреждений — в итоге сценария:
                нажмите на её название.
            </div>
        </div>
    }

    <div class="card">
        <div class="card-title">Было → станет @SelectedNote</div>
        <table class="changes">
            <thead>
                <tr><th></th><th>Сейчас</th><th>Прогноз</th><th>Изменение</th></tr>
            </thead>
            <tbody>
                @Row("Вес, кг", f.Start.WeightKg, f.End.WeightKg, 1)
                @Row("Жир, %", f.Start.BodyFatPercent, f.End.BodyFatPercent, 1)
                @Row("Жировая масса, кг", f.Weeks[0].FatMassKg, f.Weeks[^1].FatMassKg, 1)
                @Row("Безжировая ткань, кг", f.Weeks[0].LeanMassKg, f.Weeks[^1].LeanMassKg, 1)
                @Row("Вода и гликоген (сдвиг), кг", 0, f.WaterChangeKg, 1)
                @foreach (Girth g in ShownGirths(f.Start))
                {
                    @Row(BodyProfile.GirthName(g) + ", см", f.Start.GetGirth(g), f.End.GetGirth(g), 1)
                }
            </tbody>
        </table>
    </div>

    <div class="card">
        <div class="card-title">Вес по неделям, кг</div>
        <label class="check"><input type="checkbox" @bind="_showBaseline" />Показать базовый прогноз</label>
        <div class="note">Сплошная линия — ожидаемый результат; полоса — ожидаемый диапазон; точки — фактические измерения.</div>
        <WeightChart Series="ChartSeries" Selected="Hypotheses.Selected" Target="@(Personalized.Selected is { } saved ? saved.Input().TargetWeightKg : Hypothesis.TargetWeightKg)" OnSelect="Select"
                     Facts="PersonalizedFacts" TodayWeek="PersonalizedTodayWeek" Archive="Personalized.Display" ShowBaseline="_showBaseline" />
        <details style="margin-top: 8px">
            <summary class="note">Таблица по неделям@(Forecasts.Count > 1 ? $" — «{Hypotheses.Current.Name}»" : "")</summary>
            <table class="changes" style="margin-top: 6px">
                <thead>
                    <tr><th>Неделя</th><th>Вес, кг</th><th>Жир, %</th><th>Расход, ккал/д</th><th>Баланс</th></tr>
                </thead>
                <tbody>
                    @foreach (var w in f.Weeks)
                    {
                        <tr>
                            <td>@w.Week</td>
                            <td>@Fmt.N(w.WeightKg, 1)</td>
                            <td>@Fmt.N(w.FatPercent, 1)</td>
                            <td>@Fmt.N(w.ExpenditureKcalPerDay)</td>
                            <td>@Fmt.Signed(w.BalanceKcalPerDay, 0)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </details>
    </div>


}

@code {
    [Parameter, EditorRequired] public PersonalizedForecastState Personalized { get; set; } = default!;
    [Parameter] public EventCallback OnSaveForecast { get; set; }
    [Parameter] public EventCallback OnNewForecast { get; set; }
    [Parameter] public EventCallback<string?> OnSelectForecast { get; set; }
    [Parameter] public EventCallback OnImportLegacy { get; set; }
    private bool _showBaseline = true;
    private IReadOnlyList<HypothesisForecast> ChartSeries => Personalized.Selected is not null && Selected is { } chosen ? new[] { chosen } : Forecasts;
    private double? PersonalizedTodayWeek => Personalized.Display is { } f ? ForecastTracking.WeekOf(f.StartDate, Today) : null;
    private IReadOnlyList<ChartFact> PersonalizedFacts => Personalized.Evaluation.Where(o => o.Metric == ForecastEvaluationService.Weight)
        .Select(o => new ChartFact(o.HorizonDays / 7.0, o.Actual, Fmt.Date(o.Date))).ToArray();
    [Parameter, EditorRequired] public BodyProfile Profile { get; set; } = default!;
    [Parameter, EditorRequired] public StoredHypotheses Hypotheses { get; set; } = default!;
    /// <summary>Прогнозы всех гипотез в порядке списка; пусто, пока не посчитаны.</summary>
    [Parameter] public IReadOnlyList<HypothesisForecast> Forecasts { get; set; } = [];
    /// <summary>Изменение плана выбранной гипотезы.</summary>
    [Parameter] public EventCallback<Action<StoredHypothesis>> OnChange { get; set; }
    /// <summary>Выбор, копия, удаление, переименование гипотез.</summary>
    [Parameter] public EventCallback<Action<StoredHypotheses>> OnHypotheses { get; set; }
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private StoredHypothesis Hypothesis => Hypotheses.Current.Plan;
    private HypothesisForecast? Selected => Forecasts.FirstOrDefault(f => f.Hypothesis.Slot == Hypotheses.Selected);
    private ForecastResult? Forecast => Selected?.Forecast;

    /// <summary>Удаление выбранной гипотезы ждёт подтверждения: слот, для которого спросили.</summary>
    private int? _confirmDelete;
    /// <summary>Пересоздаёт поле названия, если сохранённое название отличается от набранного.</summary>
    private int _nameVersion;

    private static readonly (TrainingExperience, string)[] Experiences =
    [
        (TrainingExperience.Beginner, "Новичок"),
        (TrainingExperience.Intermediate, "Средний"),
        (TrainingExperience.Advanced, "Опытный"),
    ];

    private (double Bmr, double Total, double CardioPerSession, double StrengthPerSession) Maintenance;

    private string MaintenanceHint => "Поддержание сейчас ≈\u00A0" + Fmt.N(Maintenance.Total) + " ккал в день";

    private double MonthlyCeilingKg =>
        ForecastConstants.MonthlyLeanGainCeilingPercent(Profile.Sex, Hypothesis.Experience) / 100 * Profile.WeightKg;

    protected override void OnParametersSet()
    {
        Maintenance = ForecastEngine.Expenditure(Profile, Profile.WeightKg, Hypothesis.ToInput());
    }

    private string? _nutritionError;
    private Task Change(Action<StoredHypothesis> change)
    {
        var draft = Hypothesis.Clone(); change(draft);
        try { CompositionNutrition.Resolve(draft.ToInput()); _nutritionError = null; return OnChange.InvokeAsync(change); }
        catch (ArgumentException e) { _nutritionError = e.Message; return Task.CompletedTask; }
    }

    private Task Select(int slot) => OnHypotheses.InvokeAsync(h => h.Select(slot));

    private Task Add() => OnHypotheses.InvokeAsync(h => h.AddCopy());

    private Task Remove()
    {
        int slot = Hypotheses.Selected;
        _confirmDelete = null;
        return OnHypotheses.InvokeAsync(h => h.Remove(slot));
    }

    private async Task Rename(ChangeEventArgs e)
    {
        int slot = Hypotheses.Selected;
        string typed = e.Value?.ToString() ?? "";
        await OnHypotheses.InvokeAsync(h => h.Rename(slot, typed));
        if (Hypotheses.Current.Name != typed) _nameVersion++;
    }

    /// <summary>Подпись выбранной гипотезы в заголовке карточки — когда гипотез несколько.</summary>
    private RenderFragment? SelectedNote => Hypotheses.Items.Count < 2 ? null : __builder =>
    {
        <span class="title-note series-@Hypotheses.Current.Slot"><i class="key"></i>@Hypotheses.Current.Name</span>
    };

    /// <summary>Икра и запястье — только если указаны: иначе это оценка, а не замер.</summary>
    private static IEnumerable<Girth> ShownGirths(BodyProfile start) =>
        Enum.GetValues<Girth>().Where(g => g is not (Girth.Calf or Girth.Wrist) || start.IsSpecified(g));

    /// <summary>Без пояснения в скобках: «Бёдра (ягодицы)» → «Бёдра» — столбец подписей в сравнении узкий.</summary>
    private static string ShortGirthName(Girth g) => BodyProfile.GirthName(g).Split(" (")[0];

    private string? SelClass(HypothesisForecast hf) => hf.Hypothesis.Slot == Hypotheses.Selected ? "sel" : null;

    /// <summary>Заголовок группы — только в столбце подписей: он не прокручивается вбок вместе с таблицей.</summary>
    private RenderFragment Group(string name) => __builder =>
    {
        <tr class="group">
            <th>@name</th>
            <td colspan="@(Forecasts.Count + 1)"></td>
        </tr>
    };

    private RenderFragment PlanRow(string name, Func<HypothesisForecast, string> value) => __builder =>
    {
        <tr>
            <td>@name</td>
            <td class="now"></td>
            @foreach (var hf in Forecasts)
            {
                <td class="@SelClass(hf)">@value(hf)</td>
            }
        </tr>
    };

    private RenderFragment ResultRow(string name, double now, Func<HypothesisForecast, double> value, int decimals) => __builder =>
    {
        <tr>
            <td>@name</td>
            <td class="now">@Fmt.N(now, decimals)</td>
            @foreach (var hf in Forecasts)
            {
                <td class="@SelClass(hf)">@Fmt.N(value(hf), decimals)</td>
            }
        </tr>
    };

    private static int ParseInt(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int v) ? v : fallback;

    private Task OnCardioKind(ChangeEventArgs e) => Change(h => h.CardioKind = ParseInt(e, -1));

    private Task OnTerrain(ChangeEventArgs e) => Change(h => h.CardioTerrain = (Terrain)ParseInt(e, 0));

    private Task SetMaintenance() => Change(h => h.IntakeKcalPerDay = Math.Round(Maintenance.Total / 10) * 10);

    private static string ActivityHint(double k) => "Без учёта тренировок: " + (
        k < 1.25 ? "сидячая работа, мало ходьбы" :
        k < 1.45 ? "немного ходьбы в течение дня" :
        k < 1.65 ? "много на ногах" :
        "физический труд");

    private static RenderFragment Row(string name, double before, double after, int decimals) => __builder =>
    {
        <tr>
            <td>@name</td>
            <td>@Fmt.N(before, decimals)</td>
            <td>@Fmt.N(after, decimals)</td>
            <td class="delta">@Fmt.Signed(after - before, decimals)</td>
        </tr>
    };
}
