@using WorkoutCalculator.BodyModel.Avatars
<section class="card avatar-panel" aria-label="Аватар" data-avatar-status="@State?.Status" data-avatar-revision="@State?.ActiveRevisionId" data-avatar-revisions="@State?.Revisions.Length" aria-busy="@Busy">
    <h2>@(State?.Draft is null ? "Ваш аватар" : State.Status == AvatarStatus.Recalibrating ? "Исправление аватара" : "Создание аватара")</h2>
    @if (State is null) { <p>Дождитесь загрузки модели и завершите ввод исходных данных.</p> }
    else
    {
        @if (State.ActiveRevision is { } active)
        {
            <p>Зафиксирован @active.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · ревизий: @State.Revisions.Length.</p>
            @if (State.Draft is null) {
                <AvatarReview Inputs="active.Inputs" Corrections="active.Corrections" Quality="active.Quality" />
                <p>Исправление создаст новую ревизию и новый отсчёт прогресса. Текущий аватар и старые прогнозы сохранятся.</p>
                <button class="btn" @onclick="OnStart">Исправить аватар</button>
            }
        }
        @if (State.Draft is { } draft)
        {
            @if (State.Status == AvatarStatus.Recalibrating) {
                <p>Предыдущая ревизия зафиксирована. Вы редактируете отдельный черновик. После подтверждения потребуется начать новый цикл прогнозов.</p>
                <button class="btn" @onclick="OnMeasure">Добавить фактический замер</button>
                <button class="btn" @onclick="OnUseFact">Использовать последний факт</button>
            }
            @if (!ReviewOnly) { <AvatarCorrections Value="draft.Corrections" ValueChanged="OnEdit" /> }
            @if (Busy) { <p role="status">Перестраиваем аватар…</p> }
            <AvatarReview Inputs="draft.Inputs" Corrections="draft.Corrections" Quality="Representation?.Quality" Detailed="true" />
            @if (ShowConfirm) {
                <label class="check"><input type="checkbox" @bind="_reviewed" /> Я проверил форму, источники данных и предупреждения</label>
                <button class="btn primary" disabled="@(Busy || Representation is null || !_reviewed)" @onclick="OnConfirm">Зафиксировать аватар</button>
            }
            @if (State.Status == AvatarStatus.Recalibrating) { <button class="btn" disabled="@Busy" @onclick="OnCancel">Отменить коррекцию</button> }
        }
        @if (State.HypothesisResetRequired)
        {
            <p role="status">Начался новый отсчёт формы. Старые прогнозы сохранены. Для новых расчётов начните новый цикл.</p>
            <button class="btn" disabled="@(State.Status != AvatarStatus.Active)" @onclick="OnNewCycle">Начать новый цикл прогнозов</button>
        }
        <details><summary>История ревизий и диагностика</summary>
            @foreach (var r in State.Revisions.Reverse()) {
                <p><span class="avatar-id">@r.Id</span> · @(r.Id == State.ActiveRevisionId ? "текущая" : "архив") · @r.EffectiveDate</p>
                <p class="note">@r.BuilderVersion · @r.Corrections.CorrectionModelVersion · @r.DerivedMetrics.Source</p>
                <AvatarReview Inputs="r.Inputs" Corrections="r.Corrections" Quality="r.Quality" Detailed="true" />
            }
        </details>
    }
</section>
@code {
    [Parameter] public AvatarState? State { get; set; }
    [Parameter] public AvatarRepresentation? Representation { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ReviewOnly { get; set; }
    [Parameter] public bool ShowConfirm { get; set; } = true;
    [Parameter] public EventCallback OnStart { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnUseFact { get; set; }
    [Parameter] public EventCallback OnMeasure { get; set; }
    [Parameter] public EventCallback OnNewCycle { get; set; }
    [Parameter] public EventCallback<AvatarShapeCorrectionProfile> OnEdit { get; set; }
    private bool _reviewed;
    private AvatarDraft? _lastDraft;
    protected override void OnParametersSet() { if (_lastDraft != State?.Draft) { _reviewed = false; _lastDraft = State?.Draft; } }
}
