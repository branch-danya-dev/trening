@* Приложение: три раздела — «Модель», «Активность», «Профиль». На телефоне навигация снизу, на компьютере —
   в шапке. 3D-вид живёт всё время (холст инициализируется один раз) и прячется, когда открыт другой раздел. *@
@using WorkoutCalculator.Data
@using WorkoutCalculator.BodyModel.MakeHuman
@using WorkoutCalculator.BodyModel.Geometry
@inject HttpClient Http
@inject AppData Data
@implements IDisposable

<div class="app main-app on-@(_section.ToString().ToLowerInvariant()) @(_onboarding ? "onboarding" : null) @(_onboarding && _onboardingFull ? "ob-full" : null) @(_sheetOpen ? "sheet-open" : null)">
    <header class="topbar">
        <span class="brand-dot"></span>
        <span class="brand">Тренировки и тело</span>
        <nav class="sections" aria-label="Разделы">
            @foreach (var (section, title) in Sections)
            {
                <button class="@Css.On(_section == section)" aria-current="@(_section == section ? "page" : null)"
                        @onclick="() => Go(section)">@title</button>
            }
        </nav>
    </header>

    <div class="main">
        <section class="viewport" aria-label="3D-модель">
            <canvas id="body-canvas" tabindex="0"></canvas>
            <div class="mode-bar">
                <button class="btn view-cycle always" aria-label="Сменить ракурс" @onclick="CycleView">⟳ @ViewName(NextView)</button>
                <label class="check" title="Где меряется каждый обхват">
                    <input type="checkbox" checked="@_showTapes" @onchange="ToggleTapes" /> ленты замеров
                </label>
            </div>
            @if (!_onboarding && Data.Loaded && Data.Profile is not null)
            {
                <div class="view-bottom">
                    @if (_body is ResolvedBody peek)
                    {
                        <button class="sheet-peek" @onclick="() => _sheetOpen = true">
                            @if (Comparing)
                            {
                                <span>Сравнение: @Label(Earlier) → @Label(Later)</span>
                            }
                            else
                            {
                                <span>@Fmt.N(peek.Body.WeightKg, 1)&nbsp;кг · @Fmt.N(peek.Body.BodyFatPercent, 0)&nbsp;% жира · @Label(_date)</span>
                            }
                            <b>@(Comparing ? "Разница" : "Параметры")</b>
                        </button>
                    }
                    <HistoryBar Marks="HistoryBar.From(Data.Entries)" Selected="_date" CompareWith="_compareDate" Comparing="_comparing"
                                OnSelect="SetDate" OnSelectOther="SetCompareDate" OnCompare="ToggleCompare" />
                </div>
            }
            @if (ViewMessage is string message)
            {
                <div class="view-status">@message</div>
            }
            @if (Features.Debug && _scene.Body(BodyScene.Primary) is IBodyShape current)
            {
                <div class="view-stats">
                    @(current is MakeHumanBody mhb ? $"MakeHuman, сечений {mhb.Measurements}" : $"Манекен, {Mannequin.Segments} точек на сечение") ·
                    @Fmt.N(current.Mesh.VertexCount) вершин · сетка @Fmt.N(_scene.BuildMs) мс + передача @Fmt.N(_scene.UploadMs) мс ·
                    проверка @Fmt.N(_scene.CheckMs) мс
                </div>
            }
        </section>

        <aside class="panel model-panel">
            <div class="panel-body">
                @if (!Data.Loaded)
                {
                    <div class="note">Загружаю данные…</div>
                }
                else if (Data.LoadError is string error)
                {
                    <div class="hint">@error</div>
                }
                else if (_onboarding)
                {
                    <Onboarding Scene="_scene" OnFullScreen="full => _onboardingFull = full" OnFinished="() => _onboarding = false" />
                }
                else if (Comparing)
                {
                    <CompareCard Earlier="Earlier" Later="Later" SideBySide="_sideBySide" SideBySideChanged="SetSideBySide"
                                 OnClose="() => _sheetOpen = false" />
                }
                else
                {
                    <MeasureWidget Date="_date" DateChanged="SetDate" Scene="_scene" Focus="_focusGirth" FocusToken="_focusToken"
                                   OnClose="() => _sheetOpen = false" />
                }
            </div>
        </aside>

        @* «Активность» не пересоздаётся при смене раздела: незаконченная правка тренировки остаётся *@
        @if (Data.Loaded && !_onboarding)
        {
            <div class="page" hidden="@(_section != Section.Activity)">
                <ActivitySection />
            </div>
        }
        @if (_section == Section.Profile)
        {
            <div class="page">
                <ProfileSection />
            </div>
        }
    </div>

    <nav class="bottom-nav" aria-label="Разделы">
        @foreach (var (section, title) in Sections)
        {
            <button class="@Css.On(_section == section)" aria-current="@(_section == section ? "page" : null)"
                    @onclick="() => Go(section)">@title</button>
        }
    </nav>
</div>

@code {
    private enum Section { Model, Activity, Profile }

    private static readonly (Section Section, string Title)[] Sections =
    [
        (Section.Model, "Модель"),
        (Section.Activity, "Активность"),
        (Section.Profile, "Профиль"),
    ];

    private Section _section = Section.Model;
    private BodyScene _scene = default!;
    private bool _viewerReady, _showTapes;
    private ResolvedBody? _body;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    /// <summary>Подпись поверх 3D-вида, пока модели нет.</summary>
    private string? ViewMessage =>
        !Data.Loaded ? "Загружаю данные…"
        : Data.Profile is null ? null
        : _body is null ? null
        : _scene.Status;

    protected override void OnInitialized()
    {
        _scene = new BodyScene(() => InvokeAsync(StateHasChanged));
        Data.Changed += OnDataChanged;
        _ = _scene.LoadAsync(Http);
        _ = Data.LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        ViewerInterop.Init("body-canvas");
        ViewerInterop.OnPick(OnPick);
        _viewerReady = true;
        _scene.ViewerReady();
        UpdateModel();
    }

    public void Dispose()
    {
        Data.Changed -= OnDataChanged;
        ViewerInterop.OnPick(null);
    }

    /// <summary>Дата, на которую показана модель и правятся замеры.</summary>
    private DateOnly _date = DateOnly.FromDateTime(DateTime.Now);

    /// <summary>Телефон: шторка с параметрами открыта.</summary>
    private bool _sheetOpen;
    private Girth? _focusGirth;
    private int _focusToken;

    private void SetDate(DateOnly date)
    {
        _date = date;
        if (_compareDate == date) _compareDate = null;
        UpdateModel();
    }

    private static string Label(DateOnly d) => d == Today ? "сегодня" : Fmt.Date(d);

    /// <summary>Сравнение двух дат: включено кнопкой «Сравнить», вторая дата — нажатием на шкале.</summary>
    private bool _comparing, _sideBySide;
    private DateOnly? _compareDate;

    private bool Comparing => _comparing && _compareDate is not null;
    private DateOnly Earlier => _compareDate is DateOnly c && c < _date ? c : _date;
    private DateOnly Later => _compareDate is DateOnly c && c > _date ? c : _date;

    private void ToggleCompare()
    {
        _comparing = !_comparing;
        _compareDate = null;
        UpdateModel();
    }

    private void SetCompareDate(DateOnly date)
    {
        _compareDate = date;
        UpdateModel();
    }

    private void SetSideBySide(bool sideBySide)
    {
        _sideBySide = sideBySide;
        UpdateModel();
    }

    /// <summary>Нажатие на тело: параметры на ближайшем замере (лента подсвечивается), не замер — просто параметры.</summary>
    private void OnPick(double x, double y, double z) => _ = InvokeAsync(() =>
    {
        if (_onboarding || _scene.Body(BodyScene.Primary) is not IBodyShape body) return;
        _focusGirth = TapePicker.Nearest(body.Tapes, x, y, z);
        _focusToken++;
        _sheetOpen = true;
        StateHasChanged();
    });

    /// <summary>Мастер создания профиля: профиля нет или мастер не закончен.</summary>
    private bool _onboarding, _onboardingFull, _onboardingChecked;

    private void OnDataChanged()
    {
        if (Data.Loaded && !_onboardingChecked)
        {
            _onboardingChecked = true;
            _onboarding = Data.LoadError is null && (Data.Profile is null || Onboarding.InProgress);
            _onboardingFull = _onboarding;
        }
        UpdateModel();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Модель на выбранную дату из истории замеров. В сравнении основной слот — прежняя дата (контур или слева),
    /// второй — поздняя (сплошная модель или справа).
    /// </summary>
    private void UpdateModel()
    {
        var p = Data.Profile;
        _body = p is not null ? BodyResolver.At(p, Data.Entries, _date) : null;
        if (!_viewerReady) return;
        if (Comparing && p is not null)
        {
            _scene.Set(BodyScene.Primary, BodyResolver.At(p, Data.Entries, Earlier)?.Body);
            _scene.Set(BodyScene.Secondary, BodyResolver.At(p, Data.Entries, Later)?.Body);
            _scene.SetCompare(true, _sideBySide);
        }
        else
        {
            _scene.Set(BodyScene.Primary, _body?.Body);
            _scene.Set(BodyScene.Secondary, null);
            _scene.SetCompare(false, false);
        }
    }

    private void Go(Section section) => _section = section;

    /// <summary>Последний выбранный ракурс камеры: front, side или back.</summary>
    private string _view = "front";

    private static readonly string[] Views = ["front", "side", "back"];

    private string NextView => Views[(Array.IndexOf(Views, _view) + 1) % Views.Length];

    private static string ViewName(string view) => view switch
    {
        "side" => "Сбоку",
        "back" => "Сзади",
        _ => "Спереди",
    };

    private void CycleView()
    {
        _view = NextView;
        ViewerInterop.SetView(_view);
    }

    private void ToggleTapes(ChangeEventArgs e)
    {
        _showTapes = e.Value is true;
        _scene.ShowTapes(_showTapes);
    }
}
