@using System.Collections.Immutable
@using System.Diagnostics
@using WorkoutCalculator.BodyModel.Avatars
@using WorkoutCalculator.BodyModel.CheckIns
@using WorkoutCalculator.BodyModel.History
@using WorkoutCalculator.BodyModel.Hypotheses

<section class="card checkin-panel" data-testid="checkin-panel" aria-label="Проверить прогресс" aria-busy="@(_busy ? "true" : "false")">
    <h2>Проверить прогресс</h2>
    <p>Новый замер обновит текущий аватар, если качество данных позволит. Начало отсчёта и сохранённые прогнозы останутся прежними.</p>
    @if (_error is not null) { <p role="alert">@_error</p> }
    @if (_busy) { <p role="status">Сохраняем наблюдение и проверяем форму на этом устройстве…</p> }
    @if (!_editing) { <button class="btn primary" disabled="@(_busy || _store.Current.Error is not null || Builder is null || Avatar?.Status!=AvatarStatus.Active)" @onclick="New">Новый замер</button> }
    @if (_editing)
    {
        <fieldset disabled="@_busy">
            <legend>Новый замер</legend>
            <label>Дата замера<input type="date" aria-label="Дата замера" @bind="_date" /></label>
            <label>Вес, кг (рекомендуется)<input inputmode="decimal" aria-label="Вес нового замера" @bind="_weight" /></label>
            <label>Жир, % (необязательно)<input inputmode="decimal" aria-label="Жир нового замера" @bind="_fat" /></label>
            <details><summary>Замеры — необязательно</summary>
                @foreach(var g in Enum.GetValues<Girth>()) { <label>@BodyProfile.GirthName(g), см<input inputmode="decimal" aria-label="@(BodyProfile.GirthName(g)+" нового замера")" @bind="_girths[g]" /></label> }
            </details>
            <p class="note">Пустые поля останутся неизвестными. Введённое вручную — фактические замеры; талия и бёдра по фото — отдельные оценки.</p>
            <details open="@_photosOpen"><summary>Фото — необязательно</summary>
                <label>Фото спереди<input id="checkin-front" type="file" accept="image/*" aria-label="Фото спереди для замера" /></label>
                <label>Фото сбоку<input id="checkin-side" type="file" accept="image/*" aria-label="Фото сбоку для замера" /></label>
                <label>Фото сзади — только для визуальной истории<input id="checkin-back" type="file" accept="image/*" aria-label="Фото сзади для истории" /></label>
                <button class="btn" @onclick="SavePhotos">Сохранить выбранные фото</button>
                <label>Сохранённые фото<select aria-label="Фото для нового замера" @bind="_sessionId"><option value="">Без фото</option>
                    @foreach(var s in _photos) { <option value="@s.Id">@s.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @string.Join(" / ",s.Views.Select(ViewName))</option> }
                </select></label>
                @if(_sessionId.Length>0) { <label class="check"><input type="checkbox" @bind="_original" /> Это мои реальные фото в указанную дату, без генерации и изменения формы</label> }
                <p class="note">Фото остаются на устройстве. Для реконструкции нужны спереди + сбоку. Фото сзади не создаёт замеров. Защита PIN настраивается в разделе «Фото».</p>
            </details>
            <button class="btn primary" @onclick="Submit">Сохранить замер и обновить аватар</button>
            <button class="btn-link" @onclick="()=>_editing=false">Отмена</button>
        </fieldset>
    }
    @if (_result is { } result)
    {
        <div data-testid="checkin-result" data-checkin-status="@result.Status" role="status">
            <h3>@(result.Quality?.ObservationAccepted==false ? "Наблюдение отклонено" : result.Revision is not null ? "Аватар обновлён по новым данным" : result.Snapshot is not null ? "Замеры сохранены, аватар не обновлён" : "Фото сохранено для истории")</h3>
            @if(result.Snapshot is { } fact) { <p>@FactsCaption(fact)</p> }
            @foreach(var reason in result.Quality?.Reasons ?? []) { <p>@CheckInQualityPolicy.Message(reason)</p> }
            @if(result.LinkedHypothesisId is not null && result.Snapshot?.WeightKg is not null && !OutcomeAttached(result))
            {
                <p>Замер сохранён. Теперь его можно использовать как независимый результат гипотезы.</p>
                <button class="btn primary" disabled="@_busy" @onclick="()=>Attach(result)">Использовать для проверки гипотезы</button>
            }
            @if(OutcomeAttached(result)) { <p>Сравнение прогноза с фактом сохранено и доступно ниже в истории гипотез.</p> }
        </div>
    }
    @foreach(var pending in _store.Current.Data.Items.Where(c=>!c.Terminal))
    { <button class="btn" disabled="@_busy" @onclick="()=>Resume(pending)">Продолжить обработку замера от @pending.ObservedDate.ToString("dd.MM.yyyy")</button> }
    <button class="btn-link" disabled="@_busy" @onclick="OnRecalibrate">Исправить аватар вручную</button>
    <details><summary>История замеров и обновлений</summary>
        @foreach(var c in _store.Current.Data.Items.Where(c=>c.Terminal).Reverse())
        {
            <article class="checkin-history" data-testid="checkin-history">
                <h3>@c.ObservedDate.ToString("dd.MM.yyyy") · @(c.Photo is null?"Фактический замер":"Замер с фото")</h3>
                <p>@(c.Revision is null?"Предыдущий аватар сохранён":"Аватар обновлён")</p>
                @if(c.Snapshot is { } f) { <p>@FactsCaption(f)</p> }
                @if(c.Id!=_result?.Id && c.LinkedHypothesisId is not null && c.Snapshot?.WeightKg is not null && !OutcomeAttached(c))
                { <button class="btn" disabled="@_busy" @onclick="()=>Attach(c)">Использовать для проверки гипотезы</button> }
                @foreach(var reason in c.Quality?.Reasons??[]) { <p class="note">@CheckInQualityPolicy.Message(reason)</p> }
                <details><summary>Источники и сравнение с предыдущей формой</summary>
                    <p>Ручные замеры сохранены как факт. Обхваты 3D — производные формы. Разница после подгонки не является независимой оценкой точности.</p>
                    @foreach(var d in c.Quality?.Girths??[]) { <p>@BodyProfile.GirthName(d.Girth): предыдущая 3D @Num(d.PreviousMeshCm), лента @Num(d.ManualCm), фото @Num(d.PhotoCm), отклонение новой 3D от ленты @Num(d.FittedMinusManualCm) см.</p> }
                </details>
            </article>
        }
    </details>
</section>

@code {
    [Parameter] public AvatarState? Avatar {get;set;}
    [Parameter] public Profile? Profile {get;set;}
    [Parameter] public AvatarBuilder? Builder {get;set;}
    [Parameter] public bool StartOpen {get;set;}
    [Parameter] public EventCallback OnChanged {get;set;}
    [Parameter] public EventCallback OnRecalibrate {get;set;}
    private readonly CheckInStore _store=new(new BrowserJournalStorage());
    private List<PhotoSession> _photos=[];
    private Dictionary<Girth,string> _girths=Enum.GetValues<Girth>().ToDictionary(g=>g,_=>"");
    private string _weight="",_fat="",_sessionId="";
    private DateTime _date=DateTime.Today;
    private bool _editing,_busy,_original,_photosOpen;
    private string? _error;
    private BodyCheckIn? _result;
    protected override async Task OnInitializedAsync()
    {
        var watch=Stopwatch.StartNew();_store.Load();_error=_store.Current.Error is null?null:"История замеров недоступна. Исходные данные сохранены; новый замер временно недоступен.";
        try{_photos=await PhotoStore.ListMeta();}catch(Exception e){_error=e.Message.Split('\n')[0];}
        if(StartOpen)New();
        Console.WriteLine($"CheckIn open: {watch.Elapsed.TotalMilliseconds:F2} ms");
    }
    private void New(){_editing=true;_result=null;_weight=_fat=_sessionId="";_date=DateTime.Today;_original=false;_girths=Enum.GetValues<Girth>().ToDictionary(g=>g,_=>"");}
    private static double? Parse(string text){if(string.IsNullOrWhiteSpace(text))return null;if(double.TryParse(text.Replace(',','.'),System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out var n)&&double.IsFinite(n))return n;throw new ArgumentException("Введите число или оставьте поле пустым.");}
    private async Task SavePhotos()
    {
        if(Profile is null)return;
        _busy=true;_error=null;
        try{var s=await PhotoStore.SaveCheckInInputs(Profile,DateOnly.FromDateTime(_date),"checkin-front","checkin-side","checkin-back");_photos=await PhotoStore.ListMeta();_sessionId=s.Id;_photosOpen=true;}
        catch(Exception e){_error=e.Message.Split('\n')[0];}finally{_busy=false;}
    }
    private CheckInPhoto Evidence(PhotoSession session,bool original) => CheckInQualityPolicy.Analyze(session.Id,
        session.ObservedDate??DateOnly.FromDateTime(session.CreatedAt.LocalDateTime),session.SourceKind switch{"Generated"=>CheckInPhotoSource.Generated,"Synthetic"=>CheckInPhotoSource.Synthetic,null or "OriginalObservation"=>CheckInPhotoSource.OriginalObservation,_=>CheckInPhotoSource.Unknown},original,
        session.Sex,session.HeightCm,session.Views.Contains("front"),session.Views.Contains("side"),session.Views.Contains("back"),session.Analysis?.Front,session.Analysis?.Side);
    private async Task Submit()
    {
        if(Avatar is null||Profile is null||Builder is null)return;
        _busy=true;_error=null;var watch=Stopwatch.StartNew();
        try
        {
            var manual=new CheckInFacts(Parse(_weight),Parse(_fat),_girths.Where(p=>!string.IsNullOrWhiteSpace(p.Value)).ToImmutableDictionary(p=>p.Key,p=>Parse(p.Value)!.Value));
            var session=_photos.SingleOrDefault(s=>s.Id==_sessionId);
            if(session is not null&&!_original)throw new ArgumentException("Подтвердите источник и дату фото.");
            var c=CheckInService.Create(Profile,Avatar,Guid.NewGuid().ToString(),DateOnly.FromDateTime(_date),DateTimeOffset.Now,manual,
                session is null?null:Evidence(session,_original),Candidate(DateOnly.FromDateTime(_date)));
            _store.Begin(c);await Run(c);_editing=false;
            Console.WriteLine($"CheckIn save total: {watch.Elapsed.TotalMilliseconds:F2} ms");
        }
        catch(Exception e){_error=e.Message.Split('\n')[0];}finally{_busy=false;}
    }
    private async Task Resume(BodyCheckIn c){_busy=true;_error=null;try{await Run(c);}catch(Exception e){_error=e.Message.Split('\n')[0];}finally{_busy=false;}}
    private async Task Run(BodyCheckIn c)
    {
        if(Builder is null)return;
        if(c.Status==CheckInStatus.Draft)
        {
            if(c.Photo is { } photo && (photo.Front||photo.Side))
            {
                var session=(await PhotoStore.ListMeta()).SingleOrDefault(s=>s.Id==photo.SessionId);
                if(session is not null)
                {
                    bool technicalFailure=false;
                    if(session.Analysis is null && photo.Source==CheckInPhotoSource.OriginalObservation)
                    {
                        if((await PhotoStore.Pin()).Locked)throw new ArgumentException("Разблокируйте фото PIN-кодом в разделе «Фото», затем продолжите этот замер.");
                        var timer=Stopwatch.StartNew();
                        try{await PhotoAnalyzer.Analyze(session);}
                        catch(Exception e){technicalFailure=!e.Message.Contains("На снимке не найден человек",StringComparison.Ordinal);}
                        Console.WriteLine($"CheckIn photo analysis: {timer.Elapsed.TotalMilliseconds:F2} ms");
                    }
                    var analysisWatch=Stopwatch.StartNew();var evidence=Evidence(session,photo.ConfirmedOriginal);
                    if(technicalFailure)evidence=evidence with{Reasons=evidence.Reasons.Add(CheckInReason.TechnicalFailure)};
                    _store.SetDraftAnalysis(c.Id,evidence);
                    Console.WriteLine($"CheckIn photo quality and measurements: {analysisWatch.Elapsed.TotalMilliseconds:F2} ms");
                }
            }
            _store.MarkReady(c.Id);
        }
        await Task.Delay(1);
        var watch=Stopwatch.StartNew();_result=await _store.Process(c.Id,Builder);
        Console.WriteLine($"CheckIn reconstruction and commit: {watch.Elapsed.TotalMilliseconds:F2} ms");
        await OnChanged.InvokeAsync();
    }
    private string? Candidate(DateOnly date)
    {
        var store=new ObservedHypothesisStore(new BrowserJournalStorage());store.Load();store.Synchronize(DateTimeOffset.Now);
        return store.Current.Data.Items.FirstOrDefault(h=>h.IsOpen && h.Core.TrackingCycleId==Avatar?.TrackingCycleId && date>=h.Core.TargetDate.AddDays(-1)&&date<=h.Core.TargetDate.AddDays(3))?.Core.Id;
    }
    private bool OutcomeAttached(BodyCheckIn c)=>c.LinkedHypothesisId is not null && new ObservedHypothesisStore(new BrowserJournalStorage()).Current.Data.Items.Any(h=>h.Core.Id==c.LinkedHypothesisId&&h.Outcome?.BodySnapshotId==c.Snapshot?.Id);
    private async Task Attach(BodyCheckIn c){var watch=Stopwatch.StartNew();_error=_store.AttachOutcome(c.Id,DateTimeOffset.Now);if(_error is null)await OnChanged.InvokeAsync();Console.WriteLine($"CheckIn hypothesis evaluation: {watch.Elapsed.TotalMilliseconds:F2} ms");}
    private static string ViewName(string v)=>v switch{"front"=>"спереди","side"=>"сбоку",_=>"сзади (история)"};
    private static string Num(double? n)=>n is { } v?Fmt.N(v,1):"—";
    private static string FactsCaption(BodySnapshot f)=>string.Join(" · ",new[]{f.WeightKg is { } w?$"Вес {Fmt.N(w,1)} кг":null,f.BodyFatPercent is { } bf?$"Жир {Fmt.N(bf,1)} %":null}.Where(s=>s is not null).Concat(f.Measurements.Select(p=>$"{BodyProfile.GirthName(p.Key)} {Fmt.N(p.Value.Cm,1)} см ({(p.Value.Method==MeasurementMethod.Manual?"лента":"оценка по фото")})")));
}
