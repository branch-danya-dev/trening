@using WorkoutCalculator.Exercises

<div class="exercise-preview">
    <div class="exercise-controls">
        <select class="select" aria-label="Упражнение" value="@State.Selected.Id" @onchange="Select">
            @foreach (var exercise in ExerciseCatalog.All)
            {
                <option value="@exercise.Id">@exercise.Name</option>
            }
        </select>
        <button class="btn" disabled="@(!State.Available)" @onclick="State.ToggleAnimation">@(State.Playing ? "■ Стоп" : "▶ Упражнение")</button>
        <label class="check"><input type="checkbox" checked="@State.Heatmap" disabled="@(!State.Available)"
            @onchange="e => State.SetHeatmap(e.Value is true)" /> Нагрузка мышц</label>
        <button class="btn" @onclick="State.Reset">Сброс упражнения</button>
    </div>
    @if (!State.Available)
    {
        <small>Анимация и подсветка доступны для MakeHuman после загрузки.</small>
    }
    <details class="exercise-details">
        <summary>Мышцы и относительная нагрузка</summary>
        <p><strong>Основные:</strong> @Names(State.Selected.PrimaryMuscles)</p>
        <p><strong>Вторичные:</strong> @Names(State.Selected.SecondaryMuscles)</p>
        <p><strong>Стабилизаторы:</strong> @Names(State.Selected.Stabilizers)</p>
        <p>Условный пример: 3 × 10, RIR 2. Роли и область подсветки приблизительные; это не EMG и не процент активации.</p>
        <p>@State.Selected.Notes</p>
    </details>
    @if (State.Heatmap && State.Available)
    {
        <label class="heatmap-intensity">Яркость подсветки
            <input aria-label="Яркость подсветки" type="range" min="0" max="1" step="0.05"
                value="@State.Intensity.ToString(CultureInfo.InvariantCulture)" @oninput="IntensityChanged" />
        </label>
        <div class="heatmap-legend"><span>0</span><i></i><span>1 · относительная нагрузка</span></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ExercisePreviewState State { get; set; } = default!;
    private static string Names(IEnumerable<string> ids) => string.Join(", ", ids.Select(id => MuscleDefinitions.Get(id).Name));
    private void Select(ChangeEventArgs e) => State.Select(e.Value?.ToString() ?? "squat");
    private void IntensityChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value) && double.IsFinite(value))
            State.SetIntensity(value);
    }
}
