@* Вкладка «Фото»: фотосессии — только на этом устройстве. Съёмка с подсказками (камера и проверка позы
   в браузере) или готовые снимки из файлов. *@
@using System.Runtime.InteropServices.JavaScript
@using System.Text.Json
@using WorkoutCalculator.BodyModel.MakeHuman
@using WorkoutCalculator.BodyModel.Photos
@implements IDisposable

@if (_pin.Locked)
{
    <div class="card">
        <div class="card-title">Фото под PIN-кодом</div>
        <div class="note" style="margin-bottom: 10px">
            Снимки на этом устройстве зашифрованы. Введите PIN-код, чтобы смотреть, снимать и разбирать их. Даты,
            вес и итоги разбора видны и без него — по ним строятся графики.
        </div>
        <form class="file-row" @onsubmit="Unlock">
            <input class="pin-input" type="password" inputmode="numeric" autocomplete="off" maxlength="8"
                   aria-label="PIN-код" placeholder="PIN-код" @bind="_pinA" @bind:event="oninput" />
            <button class="btn primary" type="submit" disabled="@(_busy || _pinA.Length < 4)">@(_busy ? "Проверяю…" : "Открыть")</button>
        </form>
        @if (_pinMessage is not null)
        {
            <div class="@(_pinError ? "hint" : "note")" style="margin-top: 10px">@_pinMessage</div>
        }
    </div>
}
else
{
<div class="card">
    <div class="card-title">Новая фотосессия</div>
    <div class="note">
        Фото хранятся только на этом устройстве и никуда не отправляются — политика безопасности страницы
        этого и не позволит. При сохранении снимки уменьшаются до 2048&nbsp;px, а метаданные, в том числе
        геопозиция, удаляются.
    </div>
    <ul class="tips">
        <li>бельё или облегающая одежда — для силуэта раздеваться не нужно;</li>
        <li>однотонный фон, ровный свет, волосы собраны, без обуви;</li>
        <li>телефон на уровне пояса в 2–3&nbsp;м, вы целиком в кадре;</li>
        <li>спереди — руки чуть в стороны, ноги на ширине таза; сбоку — руки вдоль тела, ноги вместе.</li>
    </ul>
    <button class="btn primary" disabled="@_busy" @onclick="Shoot">Снять с подсказками</button>
    <div class="note" style="margin: 6px 0 12px">
        Поставьте телефон вертикально на полку на уровне пояса. Приложение подскажет, как встать, и снимет само.
        Первый раз загрузится распознавание позы — около 22&nbsp;МБ.
    </div>
    <div class="note" style="margin-bottom: 8px">Или выберите готовые фото:</div>
    @foreach (var (view, inputId, title) in Inputs)
    {
        <div class="file-row">
            <label class="btn file-btn">
                @title
                <input id="@inputId" type="file" accept="image/*" @onchange="e => Picked(view, e)" />
            </label>
            <span class="file-name">@(_picked.GetValueOrDefault(view) ?? "не выбрано")</span>
        </div>
    }
    <button class="btn primary" style="margin-top: 12px" disabled="@(_busy || _picked.Count == 0)" @onclick="Save">
        @(_busy ? "Сохраняю…" : "Сохранить сессию")
    </button>
    @if (_message is not null)
    {
        <div class="@(_error ? "hint" : "note")" style="margin-top: 10px">@_message</div>
    }
</div>
}

<div class="card">
    <div class="card-title">
        Сессии
        @if (_sessions.Count > 0)
        {
            <span class="title-note">@_sessions.Count</span>
        }
    </div>
    @if (!_loaded)
    {
        <div class="note">Загрузка…</div>
    }
    else if (_sessions.Count == 0)
    {
        <div class="note">Пока нет ни одной. Сохраните первую — с ней будут сравниваться следующие.</div>
    }
    @foreach (var s in _sessions)
    {
        <div class="session @Css.On(s.Id == _openId)">
            <button class="session-thumbs @(_privacy.Blur ? "private" : "")" disabled="@_pin.Locked"
                    title="@(_pin.Locked ? "Снимки под PIN-кодом" : "Открыть и разобрать")" @onclick="() => Open(s)">
                @if (_pin.Locked)
                {
                    @foreach (string view in s.Views)
                    {
                        <span class="thumb-locked" aria-label="@(view == "side" ? "Сбоку" : "Спереди"), под PIN-кодом">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
                        </span>
                    }
                }
                else
                {
                    @foreach (var (view, url) in s.Thumbs)
                    {
                        <img src="@url" alt="@(view == "side" ? "Сбоку" : "Спереди")" />
                    }
                }
            </button>
            <div class="session-info">
                <b>@Fmt.DateTime(s.CreatedAt)</b>
                @if (s.Analysis is not null)
                {
                    <span class="badge">разобрано</span>
                }
                <span>@Fmt.N(s.HeightCm, 0)&nbsp;см · @Fmt.N(s.WeightKg, 1)&nbsp;кг · жир @Fmt.N(s.BodyFatPercent, 1)&nbsp;%</span>
                @if (_confirmDelete == s.Id)
                {
                    <span class="confirm">
                        Удалить сессию?
                        <button class="btn-link" @onclick="() => Delete(s.Id)">Удалить</button>
                        <button class="btn-link muted" @onclick="() => _confirmDelete = null">Отмена</button>
                    </span>
                }
                else
                {
                    <button class="btn-link muted" @onclick="() => _confirmDelete = s.Id">Удалить</button>
                }
            </div>
        </div>
    }
</div>

@if (_sessions.FirstOrDefault(s => s.Id == _openId) is PhotoSession o)
{
    var keys = KeyLevels(o.Sex);
    <div class="card">
        <div class="card-title">
            Разбор фото
            <span class="title-note">@Fmt.DateTime(o.CreatedAt)</span>
        </div>
        @if (o.Analysis is not PhotoAnalysis a)
        {
            <div class="note" style="margin-bottom: 10px">
                Найдёт контур тела и измерит ширину туловища спереди и глубину сбоку на каждом уровне — всё на этом
                устройстве. Масштаб — по росту на момент съёмки (@Fmt.N(o.HeightCm, 0)&nbsp;см).
            </div>
            <button class="btn primary" disabled="@_busy" @onclick="() => Analyze(o)">@(_busy ? "Разбираю…" : "Разобрать фото")</button>
        }
        else
        {
            @if (Model is not null && ForecastEnd is not null && a.Front is not null && a.Side is not null)
            {
                <div class="compare-row" style="margin: 0 0 10px">
                    <button class="chip @Css.On(!ShowingForecast(o))" @onclick="() => HideForecast()">Сейчас</button>
                    <button class="chip @Css.On(ShowingForecast(o))" disabled="@_warping" @onclick="() => ShowForecast(o, a)">
                        @(_warping ? "Считаю прогноз…" : $"Прогноз: {ForecastLabel}")
                    </button>
                </div>
            }
            <div class="overlay-row">
                @foreach (string view in o.Views)
                {
                    var profile = view == "side" ? a.Side : a.Front;
                    if (profile is not null && _urls.TryGetValue(view, out var url))
                    {
                        bool forecast = ShowingForecast(o) && _warpUrls.ContainsKey(view);
                        <PhotoOverlay Url="@(forecast ? _warpUrls[view] : url)" Profile="profile" KeyLevels="keys"
                                      Blur="_privacy.Blur" Watermark="@(_privacy.Watermark ? WatermarkText : null)"
                                      Model="@(forecast ? null : ModelEdges(o, view))" ShowEdges="!forecast"
                                      Ghost="@(forecast ? Contour(profile) : view == "side" ? _ghost?.SideGhost : _ghost?.FrontGhost)"
                                      Caption="@(forecast ? (view == "side" ? "Прогноз сбоку" : "Прогноз спереди") : view == "side" ? "Сбоку: глубина" : "Спереди: ширина")" />
                    }
                }
            </div>
            @if (ShowingForecast(o))
            {
                <div class="note" style="margin-top: 8px">
                    Снимок изменён так, как меняется модель MakeHuman от сегодняшних замеров к прогнозу выбранной
                    гипотезы: спереди — ширина, сбоку — живот и спина, по уровням от бёдер до шеи. Белый пунктир — контур
                    на снимке сейчас. Это иллюстрация прогноза, а не обещание: лицо, руки и ноги не меняются.
                </div>
            }
            @if ((_fit is not null && _fitSessionId == o.Id) || Compared(o) is not null)
            {
                <div class="legend-line">
                    <span class="key photo"></span>контур на фото
                    @if (_fit is not null && _fitSessionId == o.Id)
                    {
                        <span class="key model"></span><text>модель после подгонки</text>
                    }
                    @if (Compared(o) is PhotoSession c)
                    {
                        <span class="key ghost"></span><text>контур @Fmt.DateTime(c.CreatedAt)</text>
                    }
                </div>
            }
            @if (Others(o).ToList() is { Count: > 0 } others)
            {
                <div class="compare-row">
                    <span>Сравнить с:</span>
                    @foreach (var other in others)
                    {
                        var target = other;
                        <button class="chip @Css.On(_compareId == target.Id)" @onclick="() => ToggleCompare(o, target)">
                            @Fmt.DateTime(target.CreatedAt)
                        </button>
                    }
                </div>
            }
            <table class="changes" style="margin-top: 10px">
                <thead>
                    <tr><th></th><th>Ширина, см</th><th>Глубина, см</th><th>Обхват по фото, см</th><th>Замер, см</th></tr>
                </thead>
                <tbody>
                    @foreach (var (name, fraction, girth) in keys.Zip(KeyGirths, (k, g) => (k.Name, k.Fraction, g)))
                    {
                        <tr>
                            <td>@name</td>
                            <td>@Size(a.Front, fraction)</td>
                            <td>@Size(a.Side, fraction)</td>
                            <td>@PhotoGirth(girth, o.Sex, a)</td>
                            <td>@Fmt.N(Profile.GetGirth(girth), 1)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="note" style="margin-top: 8px">
                Ширина — по снимку спереди, глубина (от груди или живота до спины) — сбоку. «—»: уровень закрыт
                рукой или не найден. Обхват по фото — по ширине и глубине, формула по 6 тыс. людей ANSUR II
                (± — её средняя ошибка). Для груди такой формулы нет: в ANSUR II ширину груди мерили под мышками,
                без широчайших мышц, — со снимком не сравнить. Сильно расходится с замером — перемерьте лентой
                или переснимите.
            </div>

            @if (Compared(o) is PhotoSession cmp && _change is not null)
            {
                var (older, newer) = cmp.CreatedAt < o.CreatedAt ? (cmp, o) : (o, cmp);
                <div class="card-subtitle">Изменения с @Fmt.DateTime(older.CreatedAt) по @Fmt.DateTime(newer.CreatedAt)</div>
                <ChangeChart Levels="_change.Levels" Sex="o.Sex" />
                <table class="changes" style="margin-top: 10px">
                    <thead>
                        <tr><th></th><th>Было</th><th>Стало</th><th>Изменение</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Вес, кг</td>
                            <td>@Fmt.N(older.WeightKg, 1)</td>
                            <td>@Fmt.N(newer.WeightKg, 1)</td>
                            <td>@Fmt.Signed(newer.WeightKg - older.WeightKg, 1)</td>
                        </tr>
                        @foreach (var g in PhotoGirths.Girths)
                        {
                            var was = GirthOf(g, older);
                            var now = GirthOf(g, newer);
                            <tr>
                                <td>@(g == Girth.Waist ? "Талия" : "Бёдра") по фото, см</td>
                                <td>@(was is double w ? Fmt.N(w, 0) : "—")</td>
                                <td>@(now is double n ? Fmt.N(n, 0) : "—")</td>
                                <td>@(was is double w2 && now is double n2 ? Fmt.Signed(n2 - w2, 1) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="note" style="margin-top: 8px">
                    Снимки совмещены по макушке и масштабу роста, сбоку — ещё и по лопаткам: там спина меняется
                    меньше всего. Разница в полсантиметра и меньше — шум (поза, дыхание, одежда, свет), а не
                    изменение тела. Обхваты по фото — оценка с ошибкой ±1,5–1,8&nbsp;см, но у одного человека она
                    почти постоянна, поэтому разница между сессиями точнее самих обхватов.
                </div>
            }

            <div class="card-subtitle">Модель по фото</div>
            @if (Model is null)
            {
                <div class="note">Подгонка работает с моделью MakeHuman — она ещё загружается или не загрузилась.</div>
            }
            else if (a.Front is null || a.Side is null)
            {
                <div class="note">Для подгонки нужны оба снимка — спереди и сбоку.</div>
            }
            else
            {
                <div class="note" style="margin-bottom: 10px">
                    Подберёт осанку и форму модели так, чтобы её силуэт совпал со снимками: спереди — ширина, сбоку —
                    живот, грудь и изгиб спины. Обхваты остаются вашими замерами. Займёт несколько секунд.
                </div>
                <button class="btn primary" disabled="@(_busy || _fitting)" @onclick="() => FitModel(o, a)">
                    @(_fitting ? $"Подгоняю… сборка {_fitBuilds}" : "Подогнать модель по фото")
                </button>
                @if (_fit is PhotoFitResult f && _fitSessionId == o.Id)
                {
                    <div class="volume-line">
                        Силуэты расходились в среднем на @Fmt.N(f.ErrorBeforeCm, 1)&nbsp;см, после подгонки —
                        на @Fmt.N(f.ErrorAfterCm, 1)&nbsp;см · @f.Builds сборок тела
                    </div>
                    <table class="changes" style="margin-top: 8px">
                        <tbody>
                            <tr><td>Наклон таза</td><td>@Fmt.Signed(f.Posture.PelvicTilt, 0)°</td></tr>
                            <tr><td>Прогиб в пояснице</td><td>@Fmt.Signed(f.Posture.Lordosis, 0)°</td></tr>
                            <tr><td>Сутулость</td><td>@Fmt.Signed(f.Posture.Kyphosis, 0)°</td></tr>
                            <tr><td>Живот</td><td>@Fmt.Signed(f.Form.Stomach * 100, 0)</td></tr>
                            <tr><td>Ягодицы</td><td>@Fmt.Signed(f.Form.Buttocks * 100, 0)</td></tr>
                            <tr><td>Глубина корпуса</td><td>@Fmt.Signed(f.Form.TorsoDepth * 100, 0)</td></tr>
                            <tr><td>V-силуэт</td><td>@Fmt.Signed(f.Form.VShape * 100, 0)</td></tr>
                        </tbody>
                    </table>
                    <div class="confirm">
                        <span>Применено к модели — ползунки «Осанка и форма» на вкладке «Параметры».</span>
                        @if (_undo is not null)
                        {
                            <button class="btn-link" @onclick="Undo">Вернуть как было</button>
                        }
                    </div>
                }
            }
            @if ((a.Front?.Warnings ?? []).Concat(a.Side?.Warnings ?? []).Distinct().ToList() is { Count: > 0 } warnings)
            {
                <div class="hints" style="margin-top: 10px">
                    @foreach (var w in warnings)
                    {
                        <div class="hint">@w</div>
                    }
                </div>
            }
            <div class="volume-line">
                1&nbsp;пиксель ≈ @Fmt.N((a.Front ?? a.Side)!.CmPerPixel * 10, 1)&nbsp;мм@(a.Front?.ScaleFromSide == true ? " (масштаб спереди — по снимку сбоку)" : "")
                · разбор @Fmt.N(a.Milliseconds)&nbsp;мс
            </div>
            <div class="confirm">
                <button class="btn-link" disabled="@_busy" @onclick="() => Analyze(o)">
                    @(_busy ? "Разбираю…" : "Разобрать заново")
                </button>
                <button class="btn-link" @onclick="() => ToggleReport(o)">
                    @(_report is not null && _reportFor == o.Id ? "Скрыть отчёт" : "Отчёт для проверки")
                </button>
            </div>
            @if (_report is not null && _reportFor == o.Id)
            {
                <div class="note" style="margin-top: 8px">
                    Только цифры — ни снимков, ни контуров. Скопируйте и пришлите, если что-то разошлось с лентой
                    или подгонка выглядит странно.
                </div>
                <textarea class="report" readonly rows="14" aria-label="Отчёт для проверки" @onfocus="SelectReport">@_report</textarea>
                <div class="confirm">
                    <button class="btn" @onclick="CopyReport">Скопировать</button>
                    @if (_reportNote is not null)
                    {
                        <span class="muted">@_reportNote</span>
                    }
                </div>
            }
        }
        <div class="confirm">
            <button class="btn-link muted" @onclick="Close">Закрыть</button>
        </div>
    </div>
}

<div class="card">
    <div class="card-title">
        Защита
        @if (_pin.Enabled)
        {
            <span class="badge">PIN</span>
        }
    </div>
    @if (!_pin.Enabled)
    {
        <div class="note" style="margin-bottom: 10px">
            PIN-код шифрует снимки и превью на этом устройстве (AES-256, ключ — из PIN-кода). Без него их не
            открыть ни в приложении, ни в данных браузера. Снимки закрываются после перезагрузки, кнопкой и через
            2&nbsp;минуты в фоне. Забудете PIN-код — снимки не восстановить, только из архива.
        </div>
    }
    else
    {
        <div class="note" style="margin-bottom: 10px">
            Снимки и превью зашифрованы. @(_pin.Unlocked
                ? "Сейчас открыты: закроются после перезагрузки, кнопкой или через 2 минуты в фоне."
                : "Сейчас закрыты — PIN-код вводится вверху вкладки.")
            Даты, вес и итоги разбора не шифруются — по ним строятся графики.
        </div>
    }
    @if (_pinMode == PinMode.Enable)
    {
        <form @onsubmit="EnablePin">
            <div class="file-row">
                <input class="pin-input" type="password" inputmode="numeric" autocomplete="new-password" maxlength="8"
                       aria-label="Новый PIN-код" placeholder="PIN-код" @bind="_pinA" @bind:event="oninput" />
                <input class="pin-input" type="password" inputmode="numeric" autocomplete="new-password" maxlength="8"
                       aria-label="PIN-код ещё раз" placeholder="ещё раз" @bind="_pinB" @bind:event="oninput" />
            </div>
            <div class="confirm">
                <button class="btn primary" type="submit" disabled="@(_busy || _pinA.Length < 4 || _pinB.Length < 4)">
                    @(_busy ? "Шифрую снимки…" : "Включить")
                </button>
                <button class="btn-link muted" type="button" @onclick="CancelPin">Отмена</button>
            </div>
            <div class="note" style="margin-top: 6px">От 4 до 8 цифр.</div>
        </form>
    }
    else if (_pinMode == PinMode.Disable)
    {
        <form @onsubmit="DisablePin">
            <div class="file-row">
                <input class="pin-input" type="password" inputmode="numeric" autocomplete="off" maxlength="8"
                       aria-label="PIN-код" placeholder="PIN-код" @bind="_pinA" @bind:event="oninput" />
                <button class="btn" type="submit" disabled="@(_busy || _pinA.Length < 4)">@(_busy ? "Расшифровываю…" : "Снять защиту")</button>
                <button class="btn-link muted" type="button" @onclick="CancelPin">Отмена</button>
            </div>
        </form>
    }
    else if (!_pin.Enabled && !_secure)
    {
        <div class="hint">
            PIN-код работает только на сайте по HTTPS: браузер не даёт шифрование странице, открытой по
            обычному http (например, с компьютера по локальной сети). Откройте опубликованную версию.
        </div>
    }
    else if (!_pin.Enabled)
    {
        <button class="btn" disabled="@_busy" @onclick="() => StartPin(PinMode.Enable)">Установить PIN-код</button>
    }
    else if (_pin.Unlocked)
    {
        <div class="file-row">
            <button class="btn" @onclick="Lock">Закрыть снимки</button>
            <button class="btn-link muted" @onclick="() => StartPin(PinMode.Disable)">Снять защиту</button>
        </div>
    }
    @if (_pinMessage is not null && !_pin.Locked)
    {
        <div class="@(_pinError ? "hint" : "note")" style="margin-top: 10px">@_pinMessage</div>
    }
    <div class="privacy-options">
        <label class="check">
            <input type="checkbox" checked="@_privacy.Blur" @onchange="e => SetPrivacy(p => p.Blur = e.Value is true)" />
            Размывать снимки, пока не нажмёте на них
        </label>
        <label class="check">
            <input type="checkbox" checked="@_privacy.Watermark" @onchange="e => SetPrivacy(p => p.Watermark = e.Value is true)" />
            Водяной знак «@WatermarkText» поверх снимков
        </label>
    </div>
    <div class="note" style="margin-top: 8px">
        Запретить снимок экрана веб-страница не может — водяной знак останется на нём и напомнит, чьё это фото.
        Пока приложение свёрнуто, снимки размыты и в переключателе приложений не видны. PIN-код защищает от
        случайного взгляда и чужих рук, но не от взлома устройства — поэтому лучше ещё и блокировка самого телефона.
    </div>
</div>

<div class="card">
    <div class="card-title">Хранилище</div>
    <div class="volume-line" style="margin-top: 0">
        @if (_storage?.Usage is long usage)
        {
            <text>Сайт занимает ≈&nbsp;@Megabytes(usage)&nbsp;МБ@(_storage.Quota is long quota ? $" из {Megabytes(quota)} МБ" : "").</text>
        }
        @(_storage?.Persisted == true
            ? " Браузер не сотрёт данные при нехватке места."
            : " Браузер может стереть данные при нехватке места или долгом перерыве (Safari — через неделю без захода). " +
              "Надёжнее установить приложение на главный экран и время от времени сохранять архив.")
    </div>
    <div class="file-row" style="margin-top: 12px">
        <button class="btn" disabled="@(_busy || _sessions.Count == 0 || _pin.Locked)" @onclick="Export">Сохранить архив (zip)</button>
        <label class="btn file-btn @(_pin.Locked ? "disabled" : "")">
            Загрузить архив
            <input id="photo-import" type="file" accept=".zip,application/zip" disabled="@_pin.Locked" @onchange="Import" />
        </label>
    </div>
    @if (_pin.Enabled)
    {
        <div class="note" style="margin-top: 8px">
            Архив — обычные JPEG, без шифрования: его можно открыть на любом компьютере. Храните его в надёжном месте.
        </div>
    }
    @if (_sessions.Count > 0)
    {
        <div class="confirm">
            @if (_confirmDeleteAll)
            {
                <span>Удалить все сессии@(_pin.Enabled ? " и PIN-код" : "") с этого устройства? Это необратимо.</span>
                <button class="btn-link" @onclick="DeleteAll">Удалить всё</button>
                <button class="btn-link muted" @onclick="() => _confirmDeleteAll = false">Отмена</button>
            }
            else
            {
                <button class="btn-link muted" @onclick="() => _confirmDeleteAll = true">Удалить все фото</button>
            }
        </div>
    }
    @if (_pin.Locked)
    {
        <div class="note" style="margin-top: 8px">
            Забыли PIN-код? Снимки без него не расшифровать: удалите все фото — PIN-код удалится вместе с ними —
            и загрузите архив, если он есть.
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public BodyProfile Profile { get; set; } = default!;
    /// <summary>Модель MakeHuman для подгонки под фото; null — ещё не загружена.</summary>
    [Parameter] public MakeHumanModel? Model { get; set; }
    /// <summary>Итог прогноза выбранной гипотезы — для «прогноза на фото»; null — прогноза нет.</summary>
    [Parameter] public BodyProfile? ForecastEnd { get; set; }
    /// <summary>Подпись прогноза: гипотеза и срок.</summary>
    [Parameter] public string ForecastLabel { get; set; } = "";
    /// <summary>Изменение профиля (осанка и форма после подгонки): родитель применяет, сохраняет и перестраивает модель.</summary>
    [Parameter] public EventCallback<Action<BodyProfile>> OnChange { get; set; }

    private const string FrontInput = "photo-front", SideInput = "photo-side", ImportInput = "photo-import";

    private static readonly (string View, string InputId, string Title)[] Inputs =
    [
        ("front", FrontInput, "Фото спереди"),
        ("side", SideInput, "Фото сбоку"),
    ];

    private const string WatermarkText = "личное фото · не пересылать";

    private enum PinMode { None, Enable, Disable }

    private List<PhotoSession> _sessions = [];
    private StorageInfo? _storage;
    /// <summary>Защита: PIN-код, ввод (дважды при установке), сообщение карточки; размытие и водяной знак.</summary>
    private PinStatus _pin = new(false, false);
    private PinMode _pinMode;
    private string _pinA = "", _pinB = "";
    private string? _pinMessage;
    private bool _pinError;
    private PhotoPrivacy _privacy = new();
    /// <summary>HTTPS или localhost: иначе нет шифрования (PIN-код) и камеры.</summary>
    private bool _secure = true;
    /// <summary>Отчёт для проверки по открытой сессии (текст) и итог копирования.</summary>
    private string? _report, _reportFor, _reportNote;
    private bool _loaded, _busy, _error;
    private string? _message;
    private string? _confirmDelete;
    private bool _confirmDeleteAll;
    /// <summary>Имена выбранных файлов по ракурсам.</summary>
    private readonly Dictionary<string, string> _picked = [];
    /// <summary>Открытая сессия и адреса её снимков целиком (blob:) — освобождаются при закрытии.</summary>
    private string? _openId;
    private readonly Dictionary<string, string> _urls = [];
    /// <summary>Последняя подгонка: к какой сессии, что было до неё (для «Вернуть как было»), ход.</summary>
    private PhotoFitResult? _fit;
    private string? _fitSessionId;
    private (Posture Posture, BodyForm Form)? _undo;
    private bool _fitting;
    private int _fitBuilds;
    /// <summary>«Прогноз на фото»: деформированные снимки открытой сессии (blob:) и для какого прогноза они.</summary>
    private readonly Dictionary<string, string> _warpUrls = [];
    private string? _warpSessionId;
    private BodyProfile? _warpFor;
    private bool _warpOn, _warping;

    /// <summary>Сравнение открытой сессии с другой: прежний контур на снимках и изменения (новее − старше).</summary>
    private string? _compareId;
    private PhotoComparison? _ghost, _change;

    protected override async Task OnInitializedAsync()
    {
        _privacy = ProfileStorage.LoadPrivacy();
        _secure = BrowserStorage.IsSecure();
        // Блокировка — кнопкой или через 2 минуты в фоне: снимки закрываются, список — с замками
        PhotoStore.OnLock(() => _ = InvokeAsync(async () =>
        {
            Close();
            await Reload();
            StateHasChanged();
        }));
        await Reload();
    }

    private async Task Reload()
    {
        try
        {
            _pin = await PhotoStore.Pin();
            _sessions = await PhotoStore.List();
            _storage = await PhotoStore.Storage();
        }
        catch (JSException e)
        {
            Show(JsError(e), error: true);
        }
        _loaded = true;
    }

    private void Picked(string view, ChangeEventArgs e)
    {
        // Браузер отдаёт «C:\fakepath\имя.jpg» — показываем только имя
        string? path = e.Value?.ToString();
        if (string.IsNullOrEmpty(path)) _picked.Remove(view);
        else _picked[view] = path[(path.LastIndexOfAny(['\\', '/']) + 1)..];
    }

    private async Task Save()
    {
        await Run(async () =>
        {
            await PhotoStore.SaveFromInputs(Profile, FrontInput, SideInput);
            _picked.Clear();
            await Reload();
            Show("Сессия сохранена.");
        });
    }

    private async Task Shoot()
    {
        await Run(async () =>
        {
            var session = await Capture.Run(Profile);
            if (session is null) return;
            await Reload();
            Show("Сессия сохранена.");
        });
    }

    private async Task Open(PhotoSession s)
    {
        if (_openId == s.Id || _pin.Locked) return;
        Close();
        _openId = s.Id;
        try
        {
            foreach (string view in s.Views)
                _urls[view] = await PhotoStore.ImageUrl(s.Id, view);
        }
        catch (JSException e)
        {
            // Закрылись между нажатием и чтением
            Close();
            Show(JsError(e), error: true);
            await Reload();
        }
    }

    private void Close()
    {
        _openId = null;
        _report = _reportFor = _reportNote = null;
        _compareId = null;
        _ghost = _change = null;
        HideForecast();
        ReleaseWarps();
        foreach (string url in _urls.Values) PhotoStore.RevokeUrl(url);
        _urls.Clear();
    }

    public void Dispose()
    {
        PhotoStore.OnLock(null);
        Close();
    }

    private void ToggleReport(PhotoSession s)
    {
        _reportNote = null;
        if (_reportFor == s.Id && _report is not null)
        {
            _report = _reportFor = null;
            return;
        }
        _report = TestReport.Build(Profile, s, _fitSessionId == s.Id ? _fit : null, BrowserStorage.BrowserInfo(), AppInfo.Build);
        _reportFor = s.Id;
    }

    private async Task CopyReport()
    {
        if (_report is null) return;
        _reportNote = await BrowserStorage.CopyText(_report)
            ? "Скопировано."
            : "Браузер не дал скопировать — выделите текст и скопируйте вручную.";
    }

    private void SelectReport() => BrowserStorage.SelectText(".report");

    private void StartPin(PinMode mode)
    {
        _pinMode = mode;
        _pinA = _pinB = "";
        _pinMessage = null;
    }

    private void CancelPin() => StartPin(PinMode.None);

    private void ShowPin(string message, bool error = false)
    {
        _pinMessage = message;
        _pinError = error;
    }

    private static bool ValidPin(string pin) => pin.Length is >= 4 and <= 8 && pin.All(char.IsAsciiDigit);

    private async Task EnablePin()
    {
        if (!ValidPin(_pinA))
        {
            ShowPin("PIN-код — от 4 до 8 цифр.", error: true);
            return;
        }
        if (_pinA != _pinB)
        {
            ShowPin("PIN-коды не совпадают.", error: true);
            return;
        }
        await RunPin(async () =>
        {
            await PhotoStore.EnablePin(_pinA);
            StartPin(PinMode.None);
            await Reload();
            ShowPin("PIN-код установлен: снимки зашифрованы. Запомните его — без PIN-кода снимки не восстановить.");
        });
    }

    private async Task DisablePin()
    {
        await RunPin(async () =>
        {
            Close();
            await PhotoStore.DisablePin(_pinA);
            StartPin(PinMode.None);
            await Reload();
            ShowPin("Защита снята: снимки хранятся без шифрования.");
        });
    }

    private async Task Unlock()
    {
        await RunPin(async () =>
        {
            await PhotoStore.Unlock(_pinA);
            StartPin(PinMode.None);
            await Reload();
        });
    }

    /// <summary>Закрыть снимки: дальше — через обработчик <see cref="PhotoStore.OnLock"/>.</summary>
    private void Lock()
    {
        _pinMessage = null;
        PhotoStore.Lock();
    }

    private async Task RunPin(Func<Task> action)
    {
        _busy = true;
        _pinMessage = null;
        try
        {
            await action();
        }
        catch (JSException e)
        {
            _pinA = _pinB = "";
            ShowPin(JsError(e), error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void SetPrivacy(Action<PhotoPrivacy> change)
    {
        change(_privacy);
        ProfileStorage.SavePrivacy(_privacy);
    }

    private async Task Analyze(PhotoSession s)
    {
        _busy = true;
        _message = null;
        if (_fitSessionId == s.Id) _fit = null; // разбор заново — прежняя подгонка к нему не относится
        try
        {
            await PhotoAnalyzer.Analyze(s);
        }
        catch (JSException e)
        {
            Show(JsError(e), error: true);
        }
        catch (InvalidOperationException e)
        {
            Show(e.Message, error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Уровни груди, талии и бёдер — те же доли роста, что у моделей.</summary>
    private static IReadOnlyList<(string Name, double Fraction)> KeyLevels(Sex sex) =>
    [
        ("Грудь", Proportions.ChestHeight(sex)),
        ("Талия", Proportions.WaistHeight(sex)),
        ("Бёдра", Proportions.HipsGirthHeight(sex)),
    ];

    private static string Size(PhotoProfile? profile, double fraction) =>
        profile?.At(fraction) is ProfileLevel l ? Fmt.N(l.SizeCm, 1) : "—";

    private bool ShowingForecast(PhotoSession s) => _warpOn && _warpSessionId == s.Id && ReferenceEquals(_warpFor, ForecastEnd);

    private void HideForecast() => _warpOn = false;

    private void ReleaseWarps()
    {
        foreach (string url in _warpUrls.Values) PhotoStore.RevokeUrl(url);
        _warpUrls.Clear();
        _warpSessionId = null;
        _warpFor = null;
    }

    /// <summary>
    /// Прогноз на фото: модели «сейчас» и «прогноз» режутся на тех же уровнях, что и снимки, разница
    /// переносится на края силуэта. Снимки пересчитываются, только если сменилась сессия или прогноз.
    /// </summary>
    private async Task ShowForecast(PhotoSession s, PhotoAnalysis a)
    {
        if (Model is null || ForecastEnd is null || a.Front is null || a.Side is null) return;
        if (_warpSessionId == s.Id && ReferenceEquals(_warpFor, ForecastEnd))
        {
            _warpOn = true;
            return;
        }
        _warping = true;
        _message = null;
        try
        {
            ReleaseWarps();
            var target = ForecastEnd;
            var fractions = a.Front.Levels.Concat(a.Side.Levels).Select(l => Math.Round(l.Fraction, 4)).Distinct().Order().ToArray();
            await Task.Yield();
            var now = Model.Build(Profile.Clone());
            await Task.Delay(1); // дать браузеру отрисовать «Считаю прогноз…»
            var later = Model.Build(target.Clone());
            double height = Profile.HeightCm / 100;
            var cur = ModelSilhouette.Measure(now.Mesh.Positions, Model.Data.Triangles, height, fractions);
            var fut = ModelSilhouette.Measure(later.Mesh.Positions, Model.Data.Triangles, height, fractions);
            foreach (var (view, profile) in new[] { ("front", a.Front), ("side", a.Side) })
            {
                var rows = PhotoWarp.Plan(profile, fractions, cur, fut).ToList();
                _warpUrls[view] = await PhotoWarpInterop.WarpImage(s.Id, view, JsonSerializer.Serialize(rows, PhotoJson.Default.ListWarpRow));
            }
            _warpSessionId = s.Id;
            _warpFor = target;
            _warpOn = true;
        }
        catch (JSException e)
        {
            Show(JsError(e), error: true);
        }
        finally
        {
            _warping = false;
        }
    }

    /// <summary>Контур снимка как «прежний» — поверх снимка с прогнозом.</summary>
    private static IReadOnlyList<GhostLevel> Contour(PhotoProfile p) =>
        p.Levels.Where(l => !l.ArmOverlap).Select(l => new GhostLevel(l.Fraction, l.Row, l.Left, l.Right)).ToList();

    /// <summary>Разобранные сессии, с которыми можно сравнить открытую, — от новых к старым.</summary>
    private IEnumerable<PhotoSession> Others(PhotoSession open) =>
        _sessions.Where(s => s.Id != open.Id && s.Analysis is not null).OrderByDescending(s => s.CreatedAt);

    /// <summary>Сессия, с которой сейчас сравнивается открытая; null — сравнения нет.</summary>
    private PhotoSession? Compared(PhotoSession open) =>
        _compareId is null || open.Analysis is null ? null : _sessions.FirstOrDefault(s => s.Id == _compareId && s.Analysis is not null);

    private void ToggleCompare(PhotoSession open, PhotoSession other)
    {
        if (_compareId == other.Id || open.Analysis is not PhotoAnalysis a || other.Analysis is not PhotoAnalysis b)
        {
            _compareId = null;
            _ghost = _change = null;
            return;
        }
        _compareId = other.Id;
        // Контур другой сессии — на снимках открытой; изменения — всегда от старшей к новой
        _ghost = PhotoComparer.Compare(b.Front, b.Side, a.Front, a.Side);
        _change = other.CreatedAt < open.CreatedAt ? _ghost : PhotoComparer.Compare(a.Front, a.Side, b.Front, b.Side);
    }

    private static double? GirthOf(Girth g, PhotoSession s) =>
        s.Analysis is { Front: PhotoProfile f, Side: PhotoProfile side } && PhotoGirths.Estimate(g, s.Sex, f, side) is PhotoGirthEstimate e
            ? e.GirthCm
            : null;

    /// <summary>Обхваты строк таблицы — в том же порядке, что <see cref="KeyLevels"/>.</summary>
    private static readonly Girth[] KeyGirths = [Girth.Chest, Girth.Waist, Girth.Hips];

    private static string PhotoGirth(Girth g, Sex sex, PhotoAnalysis a) =>
        PhotoGirths.Girths.Contains(g) && a.Front is not null && a.Side is not null
            && PhotoGirths.Estimate(g, sex, a.Front, a.Side) is PhotoGirthEstimate e
            ? $"{Fmt.N(e.GirthCm, 0)} ± {Fmt.N(e.RmseCm, 1)}"
            : "—";

    /// <summary>Края модели после подгонки на снимке ракурса; null — подгонки к этой сессии нет.</summary>
    private IReadOnlyList<PhotoFitLevel>? ModelEdges(PhotoSession s, string view) =>
        _fit is null || _fitSessionId != s.Id ? null : view == "side" ? _fit.Side : _fit.Front;

    private async Task FitModel(PhotoSession s, PhotoAnalysis a)
    {
        if (Model is null || a.Front is null || a.Side is null) return;
        _fitting = true;
        _fitBuilds = 0;
        _message = null;
        var before = (Profile.Posture, Profile.Form);
        try
        {
            // После каждой сборки отдаём поток браузеру: виден ход, страница не замирает
            var result = await PhotoFitter.FitAsync(Model, Profile.Clone(), a.Front, a.Side, async n =>
            {
                _fitBuilds = n;
                StateHasChanged();
                await Task.Delay(1);
            });
            _fit = result;
            _fitSessionId = s.Id;
            _undo = before;
            await OnChange.InvokeAsync(p =>
            {
                p.Posture = result.Posture;
                p.Form = result.Form;
            });
        }
        catch (InvalidOperationException e)
        {
            Show(e.Message, error: true);
        }
        finally
        {
            _fitting = false;
        }
    }

    private async Task Undo()
    {
        if (_undo is not (Posture posture, BodyForm form)) return;
        _undo = null;
        await OnChange.InvokeAsync(p =>
        {
            p.Posture = posture;
            p.Form = form;
        });
    }

    private async Task Delete(string id)
    {
        _confirmDelete = null;
        if (_openId == id) Close();
        await Run(async () =>
        {
            await PhotoStore.DeleteSession(id);
            await Reload();
        });
    }

    private async Task DeleteAll()
    {
        _confirmDeleteAll = false;
        Close();
        await Run(async () =>
        {
            await PhotoStore.DeleteAll();
            await Reload();
            Show("Все фото удалены с этого устройства.");
        });
    }

    private async Task Export()
    {
        await Run(async () =>
        {
            var r = await PhotoStore.Export();
            Show($"Архив «{r.Name}» сохранён: сессий — {r.Sessions}. Он нужен, чтобы перенести фото на другое " +
                 "устройство или восстановить их, если браузер сотрёт данные.");
        });
    }

    private async Task Import(ChangeEventArgs _)
    {
        await Run(async () =>
        {
            var r = await PhotoStore.Import(ImportInput);
            await Reload();
            Show(r.Skipped == 0 ? $"Добавлено сессий: {r.Added}."
                                : $"Добавлено сессий: {r.Added}, уже были или без снимков: {r.Skipped}.");
        });
    }

    /// <summary>Одна операция за раз; ошибка JS — текстом под кнопками.</summary>
    private async Task Run(Func<Task> action)
    {
        _busy = true;
        _message = null;
        try
        {
            await action();
        }
        catch (JSException e)
        {
            Show(JsError(e), error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Show(string message, bool error = false)
    {
        _message = message;
        _error = error;
    }

    /// <summary>Текст ошибки из JS без технического «Error: » в начале.</summary>
    private static string JsError(JSException e) =>
        e.Message.StartsWith("Error: ", StringComparison.Ordinal) ? e.Message["Error: ".Length..] : e.Message;

    private static string Megabytes(long bytes) => Fmt.N(bytes / 1048576.0, bytes < 10 * 1048576 ? 1 : 0);
}
