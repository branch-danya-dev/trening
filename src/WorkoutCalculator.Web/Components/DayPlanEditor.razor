@using WorkoutCalculator.Activity
@using System.Collections.Immutable
<div class="day-plan-editor">
    <label>Ходьба, км в плане<input aria-label="Ходьба, км в плане" type="number" min="0.01" max="300" step="0.1" @bind="_km" /></label>
    <label>Разминка, мин в плане<input aria-label="Разминка, мин в плане" type="number" min="1" max="1440" @bind="_mobility" /></label>
    <label>Зарядка, мин в плане<input aria-label="Зарядка, мин в плане" type="number" min="1" max="1440" @bind="_routine" /></label>
    <label class="check"><input type="checkbox" @bind="_strength" /> Силовая в плане</label>
    <label class="check"><input type="checkbox" @bind="_cardio" /> Кардио в плане</label>
    <label class="check"><input type="checkbox" @bind="_other" /> Другая активность в плане</label>
    <p class="note">Пустое поле убирает цель. План не добавляет выполненную активность.</p>
    <button class="btn" @onclick="Save">Сохранить план дня</button>
</div>
@code {
    [Parameter, EditorRequired] public DayPlan Plan { get; set; } = DayPlan.Default;
    [Parameter] public EventCallback<DayPlan> OnSave { get; set; }
    private double? _km, _mobility, _routine;
    private bool _strength, _cardio, _other;
    protected override void OnInitialized() {
        _km = Plan.Slots.FirstOrDefault(s => s.Type == ActivityEventType.Walking)?.DistanceKm;
        _mobility = Plan.Slots.FirstOrDefault(s => s.Type == ActivityEventType.Mobility)?.Minutes;
        _routine = Plan.Slots.FirstOrDefault(s => s.Type == ActivityEventType.Spontaneous)?.Minutes;
        _strength = Plan.Slots.Any(s => s.Type == ActivityEventType.Strength); _cardio = Plan.Slots.Any(s => s.Type == ActivityEventType.Cardio); _other = Plan.Slots.Any(s => s.Type == ActivityEventType.Other);
    }
    private Task Save() {
        var slots = ImmutableArray.CreateBuilder<DayPlanSlot>();
        if (_km is not null) slots.Add(new(ActivityEventType.Walking, DistanceKm: _km));
        if (_mobility is not null) slots.Add(new(ActivityEventType.Mobility, Minutes: _mobility));
        if (_routine is not null) slots.Add(new(ActivityEventType.Spontaneous, Minutes: _routine));
        if (_strength) slots.Add(new(ActivityEventType.Strength)); if (_cardio) slots.Add(new(ActivityEventType.Cardio)); if (_other) slots.Add(new(ActivityEventType.Other));
        return OnSave.InvokeAsync(new DayPlan(slots.ToImmutable()));
    }
}
