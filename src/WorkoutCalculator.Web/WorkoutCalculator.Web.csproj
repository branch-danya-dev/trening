<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Прототип 3D-модели тела по замерам: Blazor WebAssembly без бэкенда, отрисовка через three.js -->
  <PropertyGroup>
    <RootNamespace>WorkoutCalculator.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      Файлы среды .NET без хеша в имени: иначе опубликованная версия находит dotnet.js через import map,
      которую генерирует Blazor, а в index.html своя import map для three.js (в документе может быть только
      одна). Версии файлов различает service worker: кэш у каждой сборки свой.
    -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- Нужно генератору кода для [JSImport] (бинарная передача сетки в JS) -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- PWA: список файлов с хешами для офлайн-кэша (wwwroot/service-worker.published.js) -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorkoutCalculator.Core\WorkoutCalculator.Core.csproj" />
    <ProjectReference Include="..\WorkoutCalculator.BodyModel\WorkoutCalculator.BodyModel.csproj" />
    <ProjectReference Include="..\WorkoutCalculator.Data\WorkoutCalculator.Data.csproj" />
  </ItemGroup>

</Project>
