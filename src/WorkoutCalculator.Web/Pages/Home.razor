@using System.Diagnostics
@using System.Runtime.InteropServices.JavaScript
@using WorkoutCalculator.BodyModel.MakeHuman
@using WorkoutCalculator.BodyModel.Muscles
@using WorkoutCalculator.BodyModel.Photos
@inject HttpClient Http

<a class="skip-link" href="#section-content">Перейти к содержимому</a>
<div data-section="@_tab" data-onboarding-step="@_onboarding?.Step" data-build-ms="@_buildMs.ToString(CultureInfo.InvariantCulture)" data-forecast-ms="@_forecastMs.ToString(CultureInfo.InvariantCulture)" data-avatar-build-ms="@_avatarRebuildMs.ToString(CultureInfo.InvariantCulture)" data-avatar-busy="@(_avatarBusy ? "true" : "false")" data-model-ready="@(_mh is not null ? "true" : "false")" class="app product-app @(_onboarding is not null ? "is-onboarding" : null) @(_tab is Tab.Workout or Tab.Profile ? "panel-only" : null)">
    <header class="topbar">
        <span class="brand-dot"></span>
        <span class="brand">Тренировки и тело</span>
        <span class="brand-sub">ваше тело, движение и прогресс</span>
        <span class="local-badge">На вашем устройстве</span>
        @if (_kind == BodyKind.MakeHuman && _mhStatus is not null)
        {
            <span class="asset-status" role="status">@_mhStatus</span>
        }
        @if (_exercise.AtlasError is not null)
        {
            <span class="asset-status" role="status">@_exercise.AtlasError</span>
        }
    </header>

    <p class="ui-offline" role="status">Вы офлайн. Доступные локальные данные остаются на этом устройстве.</p>
    <nav class="product-nav" role="tablist" aria-label="Разделы приложения">
        <button @onkeydown="e=>NavigateKey(e,0)" @ref="_navToday" id="nav-today" aria-controls="section-content" role="tab" aria-selected="@((_tab == Tab.Workout) ? "true" : "false")" tabindex="@((_tab == Tab.Workout) ? 0 : -1)" class="@Css.On(_tab == Tab.Workout)" @onclick="OpenActivity"><NavIcon Kind="today" />Сегодня</button>
        <button @onkeydown="e=>NavigateKey(e,1)" @ref="_navModel" id="nav-model" aria-controls="section-content" role="tab" aria-selected="@((_tab is Tab.Params or Tab.Photos) ? "true" : "false")" tabindex="@((_tab is Tab.Params or Tab.Photos) ? 0 : -1)" class="@Css.On(_tab is Tab.Params or Tab.Photos)" @onclick="OpenModel"><NavIcon Kind="model" />Модель</button>
        <button @onkeydown="e=>NavigateKey(e,2)" @ref="_navProgress" id="nav-progress" aria-controls="section-content" role="tab" aria-selected="@((_tab == Tab.History) ? "true" : "false")" tabindex="@((_tab == Tab.History) ? 0 : -1)" class="@Css.On(_tab == Tab.History)" @onclick="OpenHistory"><NavIcon Kind="progress" />Прогресс</button>
        <button @onkeydown="e=>NavigateKey(e,3)" @ref="_navPlan" id="nav-plan" aria-controls="section-content" role="tab" aria-selected="@((_tab == Tab.Hypothesis) ? "true" : "false")" tabindex="@((_tab == Tab.Hypothesis) ? 0 : -1)" class="@Css.On(_tab == Tab.Hypothesis)" @onclick="OpenHypothesis"><NavIcon Kind="plan" />План</button>
        <button @onkeydown="e=>NavigateKey(e,4)" @ref="_navProfile" id="nav-profile" aria-controls="section-content" role="tab" aria-selected="@((_tab == Tab.Profile) ? "true" : "false")" tabindex="@((_tab == Tab.Profile) ? 0 : -1)" class="@Css.On(_tab == Tab.Profile)" @onclick="OpenProfile"><NavIcon Kind="profile" />Профиль</button>
    </nav>
    @if (_avatarError is not null) { <p class="avatar-error" role="alert">@_avatarError</p> }
    @if (_observedGeometryError is not null) { <p class="avatar-error" role="alert">@_observedGeometryError</p> }
    <div class="main">
        <section class="viewport @(_viewerError is not null ? "viewer-unavailable" : null)" aria-label="3D-модель">
            @if(_viewerError is not null){<div class="view-error" role="status">@_viewerError</div>}
            <canvas id="body-canvas" tabindex="0" aria-label="3D аватар. Показатели и действия доступны в текстовой панели."></canvas>

            <div class="view-toolbar">
                <button class="btn" @onclick='() => SetView("front")'>Спереди</button>
                <button class="btn" @onclick='() => SetView("side")'>Сбоку</button>
                <button class="btn" @onclick='() => SetView("back")'>Сзади</button>
                <button class="btn" @onclick='() => SetView("reset")'>Сброс камеры</button>
            </div>

            @if (_mode == ViewMode.Compare && _forecast is not null)
            {
                @if (_sideBySide)
                {
                    <div class="view-labels"><span>Сейчас</span><span class="later">@(_observedEndpoint is {} savedEndpoint ? $"Прогноз · {savedEndpoint.TargetDate:dd.MM.yyyy}" : ManyHypotheses ? _hypotheses.Current.Name : "Прогноз")</span></div>
                }
                else
                {
                    <div class="legend">
                        <span class="now">Сейчас (контур)</span>
                        <span class="later">@if(_observedEndpoint is { } endpoint) { <span>Гипотеза: @endpoint.TargetDate.ToString("dd.MM.yyyy")</span> } else { <span>@(ManyHypotheses ? $"«{_hypotheses.Current.Name}», через" : "Через") @(_personalized.Display?.Muscle is null ? _forecast.Weeks[^1].Week : ShapeWeek) нед.</span> }</span>
                    </div>
                }
            }

            <div class="mode-bar">
                @if(IsHistory && _revisionCompare){<div class="history-pair-labels"><span>До</span><span>После</span></div>}
                @* На телефоне вместо четырёх кнопок камеры — одна, ракурсы по кругу *@
                <button class="btn view-cycle" aria-label="Сменить ракурс" @onclick="CycleView">⟳ @ViewName(NextView)</button>
                <div class="seg" role="group" aria-label="Что показать">
                    <button class="@Css.On(_mode == ViewMode.Current)" @onclick="() => SetMode(ViewMode.Current)">Сейчас</button>
                    <button class="@Css.On(_mode == ViewMode.Forecast)" disabled="@(_forecast is null)"
                            @onclick="() => ShowPrimaryForecast(false)">Прогноз</button>
                    <button class="@Css.On(_mode == ViewMode.Compare)" disabled="@(_forecast is null)"
                            @onclick="() => ShowPrimaryForecast(true)">Сравнение</button>
                    <button class="@Css.On(IsHistory)" @onclick="OpenHistory">История</button>
                </div>
                @if (_mode == ViewMode.Compare)
                {
                    <label class="check">
                        <input type="checkbox" checked="@_sideBySide" @onchange="ToggleSideBySide" /> рядом
                    </label>
                }
                <button class="btn" disabled="@(_recording || _current is null)" title="Видео поворота модели — сохранится на устройство"
                        @onclick="RecordVideo">@(_recording ? "Запись…" : "● Видео")</button>
                @if (_mode is ViewMode.Forecast or ViewMode.Compare && ManyHypotheses && _observedEndpoint is null)
                {
                    <select class="select" aria-label="Какой сценарий показать" value="@_hypotheses.Selected" @onchange="OnViewHypothesis">
                        @foreach (var h in _hypotheses.Items)
                        {
                            <option value="@h.Slot">@h.Name</option>
                        }
                    </select>
                }
                @if (IsHistory)
                {
                    <div class="history-view-caption">@(_revisionCompare?RevisionCaption:HistoryCaption)</div>
                }
            </div>

            @if (_mode is ViewMode.Forecast or ViewMode.Compare && _forecastBody is MakeHumanBody { MuscleLayerLimited: true })
            {
                <div class="view-error" role="status">Локальная форма ограничена: заданные обхваты имеют приоритет.</div>
            }
            @if (_mode is ViewMode.Forecast or ViewMode.Compare && _forecastBody is MakeHumanBody { MuscleGeometryWarning: { } anatomyWarning })
            {
                <div class="view-error" role="status">@anatomyWarning</div>
            }
            @if (_videoError is not null)
            {
                <div class="view-error" role="alert">@_videoError</div>
            }
            @if (!UseMakeHuman && Avatar is not null)
            {
                <div class="view-error" role="status">Упрощённый манекен. Основная модель с визуальными коррекциями сейчас недоступна.</div>
            }

            <PhotoSurface @ref="_photoSurface" OnManage="OpenPhotos" OnSelected="ShowPhotoRevision" CompareBodies="ComparePhotoRevisions" />
            <label class="check view-tapes" title="Где меряется каждый обхват. Лента обхвата подсвечивается и при наведении на его поле">
                <input type="checkbox" checked="@_showTapes" @onchange="ToggleTapes" /> ленты замеров
            </label>

        </section>

        <main id="section-content" tabindex="-1" role="tabpanel" aria-labelledby="@NavigationId" class="panel">
            <div class="panel-body">
                @if (_onboarding is not null)
                {
                    <Onboarding Draft="_onboarding" Model="_mh" OnHighlight="SetHighlight" OnPreview="PreviewOnboarding" OnFinish="FinishOnboarding" OnPhoto="ApplyInitialPhoto" Busy="_avatarBusy">
                        <AvatarPanel State="Avatar" Representation="_avatarRepresentation" Busy="_avatarBusy" ReviewOnly="@(_onboarding.Step == 7)" ShowConfirm="@(_onboarding.Step == 7)" OnEdit="EditAvatarCorrections" OnConfirm="ConfirmAvatar" />
                    </Onboarding>
                }
                else if (_tab == Tab.Params)
                {
                    @if(_photoComparisonCaption is not null && _photoBeforeFact is {} beforePhoto && _photoAfterFact is {} afterPhoto){
                        <section class="card" aria-label="Изменения между фотосессиями"><h1>До и после</h1><p>Замеры @beforePhoto.Date.ToString("dd.MM.yyyy") → @afterPhoto.Date.ToString("dd.MM.yyyy")</p>
                        <div class="dashboard-grid"><div><small>Вес</small><strong>@PhotoWeight(beforePhoto) → @PhotoWeight(afterPhoto)</strong></div><div><small>Талия · записанные значения</small><strong>@PhotoWaist(beforePhoto) → @PhotoWaist(afterPhoto)</strong></div></div>
                        @if(beforePhoto.WeightKg is {} beforeKg && afterPhoto.WeightKg is {} afterKg){<p class="forecast-delta" style="margin-top:12px"><strong>@Fmt.Signed(afterKg-beforeKg,1) кг</strong><small>Изменение между сохранёнными замерами</small></p>}
                        <p class="note">Фото меняет внешний вид. Форма каждой модели соответствует сохранённой версии на её дату.</p></section>
                    }else{
                    <Dashboard Fact="@(_photoRevisionBody is not null ? _photoRevisionFact : CurrentFact)" Facts="_history.Timeline.Items" Cardio="_workouts" Strength="_strength" Goal="@_preferences.Goal" Plan="_hypotheses.Current" Calibration="_personalized" />
                    }
                    <div class="history-actions"><button class="btn primary" @onclick="NewCheckIn">Новый замер</button><button class="btn" @onclick="OpenPhotos">Фото</button></div>
                    @if(Avatar?.Revisions.Length>1){<button class="btn" data-testid="avatar-compare" @onclick="CompareRevisions">Сравнить с предыдущим аватаром</button>}
                    <details class="model-adjustments" data-testid="model-adjustments" open="@(Avatar?.Draft is not null)"><summary>Настройка аватара и источники данных</summary>
                    <AvatarPanel State="Avatar" Representation="_avatarRepresentation" Busy="_avatarBusy" OnMeasure="NewMeasurement" OnStart="StartAvatarRecalibration" OnEdit="EditAvatarCorrections" OnConfirm="ConfirmAvatar" OnCancel="CancelAvatarRecalibration" OnUseFact="UseCurrentAvatarFact" OnNewCycle="BeginAvatarForecastCycle" />
                    </details>
                }
                else if (_tab == Tab.Workout)
                {
                    <header class="page-intro"><p class="eyebrow">Каждый день имеет значение</p><h1>Сегодня</h1><p>Запишите движение и питание. В конце дня подтвердите итог.</p></header>
                    <ActivityCalendar OnTraining="OpenTraining" @key="_activityVisit" Avatar="Avatar" Profile="_profile" Cardio="_workouts" Strength="_strength.Summaries" OnDate="ActivityDate" OnSave="SaveWorkout" OnRemove="RemoveWorkout" OnEditStrength="EditStrength" OnShowLoad="ShowStrengthLoad" OnShowDailyLoad="ShowDailyLoad" />
                    @if (_activityEditable) {
                    <div id="training-editor" @ref="_trainingEditor" tabindex="-1"><h2>Тренировка</h2><TrainingPanel Profile="_profile" Draft="_workout" OnChange="ChangeProfile" Log="_workouts" Plan="CardioPlan()"
                                  OnSave="SaveWorkout" OnRemove="RemoveWorkout" Strength="_strength"
                                  OnStrengthChanged="_exercise.RefreshJournal" OnShowLoad="ShowStrengthLoad" /></div>
                    } else { <p class="note">Запись тренировок для выбранного дня недоступна. Выберите открытый день в календаре.</p> }
                }
                else if (_tab == Tab.Photos) { <h1>Фото</h1> }
                else if (_tab == Tab.History)
                {
                    @if (!_checkInOpen) { <ProgressOverview Facts="_history.Timeline.Items" /> }
                    <CheckInPanel @key="CheckInComponentKey" Avatar="Avatar" Profile="_avatars.Profile" Builder="AvatarBuilder" StartOpen="_checkInOpen" OnChanged="CheckInChanged" OnRecalibrate="StartAvatarRecalibration" />
                    <details class="card" open="@(_checkInChanges > 0)" data-testid="outcome-history"><summary>Прогноз и факт · история гипотез</summary><ObservedHypothesisPanel Builder="AvatarBuilder" @bind-SelectedId="_selectedHypothesisId" @key="_checkInChanges" HistoryOnly="true" OnMeasure="NewCheckIn" OnEndpoint="ShowObservedEndpoint" /></details>
                    <details class="card" data-testid="fact-history"><summary>Архив фактических замеров</summary><BodyHistory State="_history" Profile="_profile" Strength="_strength" Cardio="_workouts" OnView="ShowHistory" /></details>
                }
                else if (_tab == Tab.Profile)
                {
                    <header class="page-intro"><p class="eyebrow">Ваши настройки</p><h1>Профиль</h1><p>Личные данные, приватность и резервная копия — всё в одном месте.</p></header>
                    <section class="card"><h2>Личные данные</h2><p>@(_profile.Sex == Sex.Male ? "Мужской" : "Женский") · @_profile.HeightCm см · @_profile.Age лет</p>
                    <label>Дата рождения<input type="date" value="@_preferences.BirthDate" @onchange="ChangeBirthDate" /></label>
                    <label>Цель<select class="select" @bind="_preferences.Goal" @bind:after="SavePreferences">@foreach (var goal in Onboarding.Goals) { <option>@goal</option> }</select></label>
                    @if (_productError is not null) { <p role="alert">@_productError</p> }
                    <p>@CurrentFactCaption</p><button class="btn" @onclick="NewCheckIn">Обновить фактические параметры</button>
                    </section><section class="card"><h2>Приватность и фото</h2><p>Обычные записи и фотографии хранятся локально. Скрытой отправки нет. Файлы покидают приложение, только когда вы сами экспортируете или делитесь ими.</p>
                    <label class="check"><input type="checkbox" @bind="_privacy.Blur" @bind:after="SavePrivacy" /> Размывать фото до нажатия</label>
                    <label class="check"><input type="checkbox" @bind="_privacy.Watermark" @bind:after="SavePrivacy" /> Водяной знак на фото</label>
                    <button class="btn" @onclick="OpenPhotos">Фото и защита PIN</button></section>
                    <section aria-label="Данные"><StorageHealthPanel /><BackupPanel /></section>
                    <details class="card"><summary>Предпочтения ежедневного плана</summary><DefaultDayPlan /></details>
                    <AvatarPanel State="Avatar" Representation="_avatarRepresentation" Busy="_avatarBusy" OnMeasure="NewMeasurement" OnStart="StartAvatarRecalibration" OnEdit="EditAvatarCorrections" OnConfirm="ConfirmAvatar" OnCancel="CancelAvatarRecalibration" OnUseFact="UseCurrentAvatarFact" OnNewCycle="BeginAvatarForecastCycle" />
                    <details class="card" data-testid="advanced-settings"><summary>Дополнительно · диагностика и версии</summary>
        <div class="topbar-right">
            <span class="brand-sub model-label">Модель</span>
            <div class="seg" role="group" aria-label="Модель тела">
                <button class="@Css.On(_kind == BodyKind.MakeHuman)" @onclick="() => SetKind(BodyKind.MakeHuman)">MakeHuman</button>
                <button class="@Css.On(_kind == BodyKind.Mannequin)" disabled="@(Avatar?.Draft is not null)" @onclick="() => SetKind(BodyKind.Mannequin)">Манекен</button>
            </div>
        </div>
                    <ValidationPanel Fact="@(Avatar?.Draft?.Inputs.Fact ?? Avatar?.ActiveRevision?.Inputs.Fact ?? CurrentFact)" Profile="_profile" Body="_current" Facts="_history.Timeline.Items" Cardio="_workouts" Calibration="_personalized" Avatar="Avatar" Representation="_avatarRepresentation" />
                    <details><summary>Технические сведения</summary>
                        <p>Сборка @AppInfo.Build. Каталог: @WorkoutCalculator.Exercises.ExerciseCatalog.All.Count упражнений.</p>
                        <p>Геометрия @Fmt.N(_buildMs) мс · передача @Fmt.N(_uploadMs) мс · проверка @Fmt.N(_checkMs) мс · вершин @_current?.Mesh.VertexCount</p>
                        <p>@_history.StorageError @_strength.StorageError @_personalized.StorageError</p>
                    </details>
                    </details>
                }
                else if (_tab == Tab.Hypothesis)
                {
                    <ObservedHypothesisPanel Builder="AvatarBuilder" @bind-SelectedId="_selectedHypothesisId" OnMeasure="NewCheckIn" OnEndpoint="ShowObservedEndpoint" />
                    <details class="card" data-testid="manual-scenarios"><summary>Сценарии · задать режим вручную</summary><h2>Ручные сценарии</h2><p class="note">Задайте предположения самостоятельно. Сценарии не являются гипотезами по закрытым наблюдениям.</p>
                    <button class="btn" @onclick="ShowScenario">Показать сценарий в 3D</button>
                    <HypothesisPanel Profile="_profile" Hypotheses="_hypotheses" Forecasts="_forecasts" OnChange="ChangeHypothesis"
                                     OnHypotheses="ChangeHypotheses"
                                     Personalized="_personalized" OnSaveForecast="SaveForecast" OnNewForecast="NewForecast" OnSelectForecast="SelectForecast" OnImportLegacy="ImportLegacyForecasts" />
                    </details>
                }
                @if (_mode is ViewMode.Forecast or ViewMode.Compare && _personalized.Display?.Muscle is not null && _observedEndpoint is null)
                {
                    <div class="seg" role="group" aria-label="Слой прогноза">
                        <button class="@Css.On(!_forecastHeatmap)" @onclick="() => SetForecastHeatmap(false)">Тело</button>
                        <button class="@Css.On(_forecastHeatmap)" @onclick="() => SetForecastHeatmap(true)">Мышцы прогноза</button>
                    </div>
                    <label class="check">Неделя формы @ShapeWeek
                        <input aria-label="Неделя формы" type="range" min="0" max="@_personalized.Display.HorizonWeeks" value="@ShapeWeek" @onchange="ChangeShapeWeek" />
                    </label>
                }

                @* Keep one photo editor mounted: route changes must not discard selected files or session. *@
                @if(_onboarding is null && _mode==ViewMode.Current){<details open="@_showViewerTools" class="viewer-tools" data-testid="viewer-tools"><summary>Движение и нагрузка мышц</summary><ExercisePreview State="_exercise" /></details>}
                @if(_onboarding is null && _photosVisited){
                <div hidden="@(_tab is not (Tab.Photos or Tab.History))">
                    <details class="card photo-library" open="@(_tab==Tab.Photos)" data-testid="photo-library"><summary>Фото-прогресс</summary>
                    <PhotosPanel Profile="_profile" Model="_mh" OnChange="ChangeProfile" ForecastEnd="_forecast?.End" ForecastLabel="@ForecastLabel" RevisionManaged="@(Avatar is not null || _avatarError is not null)" OnSessionsChanged="RefreshSurfacePhotos" />
                    </details>
                </div>
                }
            </div>
        </main>
    </div>
</div>

@code {
    private enum Tab { Params, Workout, Hypothesis, Photos, History, Profile }
    private enum ViewMode { Current, Forecast, Compare, History }
    private enum BodyKind { MakeHuman, Mannequin }

    private BodyProfile _profile = BodyDefaults.Default();
    private StoredHypotheses _hypotheses = StoredHypotheses.Of(new StoredHypothesis());
    private IBodyShape? _current;
    private IBodyShape? _forecastBody;

    /// <summary>Ленты замеров: все (галочка) или только обхват, над полем которого мышь или фокус.</summary>
    private bool _showTapes;
    private Girth? _highlight;
    private bool TapesNeeded => _showTapes || _highlight is not null;
    private ConsistencyReport? _report;
    /// <summary>Прогнозы всех гипотез; <see cref="_forecast"/> — выбранной, она же в 3D.</summary>
    private IReadOnlyList<HypothesisForecast> _forecasts = [];

    private ForecastResult? _forecast;

    private BodyKind _kind = BodyKind.MakeHuman;
    private MakeHumanModel? _mh;
    /// <summary>Пока данные MakeHuman не загружены — текст состояния; показывается манекен.</summary>
    private string? _mhStatus = "загрузка…";
    /// <summary>Решения подгонки MakeHuman для «сейчас» и «прогноза» — тёплый старт следующих сборок.</summary>
    private MakeHumanFit? _fitCurrent;
    private MakeHumanFit? _fitForecast;

    private Tab _tab = Tab.Params;
    /// <summary>Расчёт тренировки в работе: переживает переключение вкладок.</summary>
    private readonly WorkoutDraft _workout = new();
    private readonly StrengthJournalState _strength = new(new StrengthJournalStore(new BrowserJournalStorage()));

    private void ShowStrengthLoad(string? sessionId)
    {
        _showViewerTools = true;
        _exercise.SetSource(sessionId is null ? MuscleLoadSource.Week : MuscleLoadSource.Session, sessionId);
        _exercise.SetHeatmap(true);
        SetMode(ViewMode.Current);
        _tab = Tab.Params;
    }
    private void ShowDailyLoad(WorkoutCalculator.Exercises.MuscleLoadResult load)
    {
        _showViewerTools = true;
        _exercise.SetDailyLoad(load);
        SetMode(ViewMode.Current);
        _tab = Tab.Params;
    }
    /// <summary>Журнал тренировок, от новых к старым.</summary>
    private List<LoggedWorkout> _workouts = ProfileStorage.LoadWorkouts();

    private bool SaveWorkout(LoggedWorkout entry)
    {
        var next = _workouts.Where(w => w.Id != entry.Id).Append(entry).OrderByDescending(w => w.Date).ToList();
        if (!ProfileStorage.SaveWorkouts(next)) return false;
        _workouts = next; StateHasChanged(); return true;
    }

    private void RemoveWorkout(string id)
    {
        var next = _workouts.Where(w => w.Id != id).ToList();
        if (ProfileStorage.SaveWorkouts(next)) _workouts = next;
    }

    /// <summary>Кардио по плану выбранной гипотезы — с ним журнал сравнивает неделю.</summary>
    private CardioPlan? CardioPlan()
    {
        var current = _hypotheses.Current;
        var plan = current.Plan;
        if (plan.CardioKind < 0 || plan.CardioPerWeek <= 0) return null;
        double perSession = ForecastEngine.Expenditure(_profile, _profile.WeightKg, plan.ToInput()).CardioPerSession;
        return new CardioPlan(current.Name, plan.CardioPerWeek, perSession * plan.CardioPerWeek);
    }
    private ViewMode _mode = ViewMode.Current;
    private bool _sideBySide;

    private bool _viewerReady;
    private bool _dirty;
    private bool _rebuilding;
    private double _buildMs;
    private double _forecastMs;
    private double _uploadMs;
    private double _checkMs;

    /// <summary>
    /// Проверка замеров и точная подгонка MakeHuman (слой под вес) дороже быстрой сборки —
    /// делаются, когда ползунок отпустили.
    /// </summary>
    private const int CheckDelayMs = 150;
    /// <summary>Прогноз пересчитывается после паузы во вводе.</summary>
    private const int ForecastDelayMs = 200;
    private int _checkVersion;
    private int _forecastVersion;

    private bool UseMakeHuman => _kind == BodyKind.MakeHuman && _mh is not null;
    private bool ManyHypotheses => _hypotheses.Items.Count > 1;

    private bool _recording;
    private string? _videoError;

    private readonly ExercisePreviewState _exercise = new();

    /// <summary>Длительность видео поворота, с.</summary>
    private const double VideoSeconds = 6;

    /// <summary>Поворот модели в видео: то же, что в виде сейчас (режим, ленты, контур сравнения).</summary>
    private async Task RecordVideo()
    {
        _recording = true;
        _videoError = null;
        try
        {
            string json = await ViewerInterop.RecordTurn(VideoSeconds);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            string url = doc.RootElement.GetProperty("url").GetString()!;
            string ext = doc.RootElement.GetProperty("ext").GetString()!;
            // Имя латиницей: часть браузеров отбрасывает кириллицу в имени скачиваемого файла
            string what = _mode switch { ViewMode.Forecast => "forecast", ViewMode.Compare => "compare", _ => "now" };
            ViewerInterop.SaveFile(url, $"body-turn-{what}-{DateTime.Now:yyyy-MM-dd}.{ext}");
        }
        catch (JSException e)
        {
            _videoError = UiError.From(e);
        }
        finally
        {
            _recording = false;
        }
    }

    /// <summary>Подпись прогноза выбранной гипотезы: название и срок.</summary>
    private string ForecastLabel => _observedEndpoint is { } endpoint ? $"Гипотеза на {endpoint.TargetDate:dd.MM.yyyy}" : _forecast is null
        ? ""
        : $"«{_personalized.Display?.HypothesisName ?? _hypotheses.Current.Name}», {_forecast.Weeks[^1].Week} нед.";

    protected override void OnInitialized()
    {
        _profile = ProfileStorage.LoadProfile() ?? BodyDefaults.Default();
        _hypotheses = ProfileStorage.LoadHypotheses() ?? StoredHypotheses.Of(DefaultHypothesis(_profile));
        _kind = ProfileStorage.LoadModelKind() == "mannequin" ? BodyKind.Mannequin : BodyKind.MakeHuman;
        _strength.Load();
        _history.Load();
        _personalized.Load();
        _avatars.Load();
        InitializeProduct();
        // The former global day reminder warmed this validated read before navigation.
        // Keep that read-only readiness without showing the reminder on unrelated screens.
        if (Avatar?.ActiveRevision is not null) _ = new ActivityDayStore(new BrowserJournalStorage()).Load();
        RefreshCalibration();
        _exercise.Journal = _strength;
        _exercise.RefreshJournal();
        _ = LoadMakeHumanAsync();
    }

    /// <summary>По умолчанию — умеренный дефицит 400 ккал от текущего расхода.</summary>
    private static StoredHypothesis DefaultHypothesis(BodyProfile p)
    {
        var h = new StoredHypothesis();
        double maintenance = ForecastEngine.Expenditure(p, p.WeightKg, h.ToInput()).Total;
        h.IntakeKcalPerDay = Math.Round((maintenance - 400) / 50) * 50;
        return h;
    }

    /// <summary>Данные MakeHuman (~2 МБ) грузятся в фоне; до этого показывается манекен.</summary>
    private async Task LoadMakeHumanAsync()
    {
        try
        {
            // Версия в адресе — чтобы браузер не взял из кэша файл старого формата
            var assets = await MakeHumanAssets.Load(Http);
            _mh = assets.Model;
            _exercise.Atlas = assets.Atlas;
            _exercise.AtlasError = assets.AtlasError;
            _mhStatus = null;
            InitializeAvatar();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidDataException)
        {
            _mhStatus = "не загрузилась, показан манекен";
        }
        if (_kind == BodyKind.MakeHuman)
            Refresh();
        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(_lastRenderedTab!=_tab){_lastRenderedTab=_tab;ViewerInterop.ResetPanelScroll();}
        if (!firstRender) return;
        try { ViewerInterop.Init("body-canvas"); _viewerReady = true; Refresh(); }
        catch (Exception) { _viewerError="3D недоступен на этом устройстве. Замеры и история остаются доступны в текстовом виде."; StateHasChanged(); }
    }

    private Tab? _lastRenderedTab;

    private void Refresh()
    {
        RequestRebuild();
        _ = ForecastLaterAsync(++_forecastVersion, 0);
        if (IsHistory) RenderHistory();
    }

    private void SetKind(BodyKind kind)
    {
        if (_kind == kind) return;
        _exercise.Stop();
        _kind = kind;
        ProfileStorage.SaveModelKind(kind == BodyKind.Mannequin ? "mannequin" : "makehuman");
        Refresh();
    }

    private void ChangeProfile(Action<BodyProfile> change)
    {
        if (Avatar is not null || _avatars.Current.Error is not null)
        {
            // Old photo/profile callbacks cannot bypass the revision lock. Calculator settings are separate.
            var candidate = _profile.Clone(); change(candidate);
            var hr = candidate.RestingHr; var vo2 = candidate.Vo2Max;
            candidate.RestingHr = _profile.RestingHr; candidate.Vo2Max = _profile.Vo2Max;
            if (System.Text.Json.JsonSerializer.Serialize(candidate, ForecastJson.Default.BodyProfile) !=
                System.Text.Json.JsonSerializer.Serialize(_profile, ForecastJson.Default.BodyProfile))
            { _avatarError = "Активная форма заблокирована. Используйте «Исправить аватар»; фото сохраняется отдельно."; return; }
            _avatarError = _avatars.UpdateCalculationSettings(hr, vo2);
            if (_avatarError is null) { _profile.RestingHr = hr; _profile.Vo2Max = vo2; }
            return;
        }
        _personalized.NewPreview();
        change(_profile);
        ProfileStorage.SaveProfile(_profile);
        RequestRebuild();
        _ = ForecastLaterAsync(++_forecastVersion, ForecastDelayMs);
    }

    private void ChangeHypothesis(Action<StoredHypothesis> change)
    {
        _observedEndpoint = null;
        _personalized.NewPreview();
        change(_hypotheses.Current.Plan);
        ProfileStorage.SaveHypotheses(_hypotheses);
        _ = ForecastLaterAsync(++_forecastVersion, ForecastDelayMs);
    }

    /// <summary>Выбор, копия, удаление, переименование. Таблица и график обновляются сразу, 3D — следующим кадром.</summary>
    private void ChangeHypotheses(Action<StoredHypotheses> change)
    {
        _observedEndpoint = null;
        int selected = _hypotheses.Selected, count = _hypotheses.Items.Count;
        change(_hypotheses);
        ProfileStorage.SaveHypotheses(_hypotheses);
        if (_hypotheses.Selected == selected && _hypotheses.Items.Count == count) return; // только название
        _personalized.NewPreview();
        RunForecasts();
        _ = ForecastLaterAsync(++_forecastVersion, 1);
    }

    private void OnViewHypothesis(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int slot))
            ChangeHypotheses(h => h.Select(slot));
    }

    private void OpenHypothesis()
    {
        _tab = Tab.Hypothesis;
        RefreshCalibration();
        Refresh();
        ShowPrimaryForecast(true);
    }

    /// <summary>Последний выбранный ракурс камеры: front, side или back.</summary>
    private string _view = "front";

    private static readonly string[] Views = ["front", "side", "back"];

    private string NextView => Views[(Array.IndexOf(Views, _view) + 1) % Views.Length];

    private static string ViewName(string view) => view switch
    {
        "side" => "Сбоку",
        "back" => "Сзади",
        _ => "Спереди",
    };

    private void SetView(string view)
    {
        _view = view == "reset" ? "front" : view;
        if (_viewerReady) ViewerInterop.SetView(view);
    }

    private void CycleView() => SetView(NextView);

    private void SetMode(ViewMode mode)
    {
        if (mode != ViewMode.Current) _exercise.Stop();
        bool wasHistory = IsHistory;
        _mode = mode;
        if (!IsHistory) {_revisionCompare=false;_photoRevisionBody=null;_photoRevisionLabel=null;_photoComparisonCaption=null;_photoRevisionFact=null;}
        if (wasHistory && !IsHistory) RestoreLiveBodies();
        ApplyMode();
    }

    private void ToggleTapes(ChangeEventArgs e)
    {
        _showTapes = e.Value is true;
        if (_showTapes) SendTapes();
        if (_viewerReady) ViewerInterop.ShowTapes(_showTapes);
    }

    private void SetHighlight(Girth? g)
    {
        if (_highlight == g) return;
        bool had = TapesNeeded;
        _highlight = g;
        if (!had && TapesNeeded) SendTapes();
        if (_viewerReady) ViewerInterop.HighlightTape(g is Girth x ? (int)x : -1);
    }

    /// <summary>Ленты для уже показанных тел (MakeHuman считает их только по запросу).</summary>
    private void SendTapes()
    {
        if (!_viewerReady) return;
        if (IsHistory)
        {
            if (_historyFromBody is not null) ViewerInterop.SetTapes("current", _historyFromBody.Tapes);
            if (_historyToBody is not null) ViewerInterop.SetTapes("forecast", _historyToBody.Tapes);
            return;
        }
        if (_current is not null) ViewerInterop.SetTapes("current", _current.Tapes);
        if (_forecastBody is not null) ViewerInterop.SetTapes("forecast", _forecastBody.Tapes);
    }

    /// <summary>Сетка в 3D-вид и, если ленты сейчас показываются, её ленты.</summary>
    private void Show(string slot, IBodyShape body)
    {
        if (!_viewerReady || IsHistory) return; // Delayed current/forecast builds must not overwrite the historical slots.
        ViewerInterop.SetGeometry(slot, body.Geometry);
        if (slot == "current") _exercise.GeometryChanged(body.Geometry.Skeleton is not null);
        if (TapesNeeded) ViewerInterop.SetTapes(slot, body.Tapes);
    }

    private void ToggleSideBySide(ChangeEventArgs e)
    {
        _sideBySide = e.Value is true;
        ApplyMode();
    }

    private void ApplyMode()
    {
        if (!_viewerReady) return;
        if (IsHistory) { RenderHistory(); return; }
        string mode = _mode switch
        {
            ViewMode.Forecast => "forecast",
            ViewMode.Compare => "compare",
            _ => "current",
        };
        ViewerInterop.SetMode(mode, _sideBySide);
    }

    /// <summary>Подсказки, которые есть только у MakeHuman: не подогнанные обхваты, слой на пределе.</summary>
    private IReadOnlyList<string> ModelHints()
    {
        if (_current is not MakeHumanBody body) return [];
        var hints = body.Misfits()
            .Select(m => $"MakeHuman не смог точно подогнать «{BodyProfile.GirthName(m.Girth)}»: " +
                         $"{Fmt.N(m.Got, 1)} см вместо {Fmt.N(m.Wanted, 1)} см.")
            .ToList();
        if (body.LayerAtMax && body.VolumeDeviation < -0.02)
            hints.Add("Для таких размеров у MakeHuman не хватает запаса формы: объём модели на " +
                      $"{Fmt.N(-body.VolumeDeviation * 100, 0)} % меньше, чем следует из веса. " +
                      "Замеры при этом проверяются по манекену.");
        return hints;
    }

    private string? ModelNote()
    {
        if (_current is not MakeHumanBody body) return null;
        double mm = body.LayerMm;
        string layer = Math.Abs(mm) < 1
            ? "Объём сошёлся с весом без слоя мягких тканей."
            : mm > 0
                ? $"Чтобы объём сошёлся с весом, добавлен слой мягких тканей: до {Fmt.N(mm, 0)} мм на животе, ягодицах " +
                  "и спине, тоньше на руках и голенях, почти нет на кистях, стопах и лице."
                : $"Чтобы объём сошёлся с весом, мягкие ткани сделаны тоньше формы MakeHuman — до {Fmt.N(-mm, 0)} мм.";
        return "MakeHuman: обхваты подогнаны таргетами замеров, а где замеров нет (колено, щиколотка, неуказанные) — " +
               "по оценке ANSUR II. " + layer;
    }

    /// <summary>
    /// Перестройка не чаще, чем успевает: пока строится сетка, новые значения ползунков только
    /// запоминаются, и следующий проход берёт самые свежие.
    /// </summary>
    private void RequestRebuild()
    {
        _dirty = true;
        if (_viewerReady && !_rebuilding)
            _ = RebuildLoopAsync();
    }

    private async Task RebuildLoopAsync()
    {
        _rebuilding = true;
        try
        {
            while (_dirty)
            {
                _dirty = false;
                var sw = Stopwatch.StartNew();
                // Быстрая сборка: MakeHuman — с прошлого решения и без подгонки слоя под вес
                IBodyShape body = UseMakeHuman ? _avatarRepresentation?.Body ?? BuildMakeHuman(_profile, ref _fitCurrent, fitVolume: false)
                    : Mannequin.Build(AvatarFallbackProfile());
                _buildMs = sw.Elapsed.TotalMilliseconds;
                sw.Restart();
                if (!ReferenceEquals(_current, body)) Show("current", body);
                _uploadMs = sw.Elapsed.TotalMilliseconds;

                _current = body;
                _ = CheckLaterAsync(++_checkVersion);
                StateHasChanged();
                await Task.Delay(1); // отдать управление браузеру: кадр и новые события ползунка
            }
        }
        finally
        {
            _rebuilding = false;
        }
    }

    private MakeHumanBody BuildMakeHuman(BodyProfile profile, ref MakeHumanFit? fit, bool fitVolume, MuscleMorphState? muscle = null,
        WorkoutCalculator.BodyModel.Muscles.MuscleGeometrySelection? muscleGeometry=null)
    {
        var body = _mh!.Build(profile, fit, fitVolume, muscle,muscleGeometry:muscleGeometry);
        fit = body.Fit;
        return body;
    }

    private async Task CheckLaterAsync(int version)
    {
        await Task.Delay(CheckDelayMs);
        if (version != _checkVersion) return; // ползунок ещё двигают
        var sw = Stopwatch.StartNew();
        var profile = _profile.Clone();

        // Проверка замеров — по манекену: он откалиброван под объём из веса и не зависит от выбранной модели
        _report = ConsistencyChecker.Check(Mannequin.Build(profile));

        if (UseMakeHuman)
        {
            var body = _avatarRepresentation?.Body ?? BuildMakeHuman(profile, ref _fitCurrent, fitVolume: true);
            if (!ReferenceEquals(_current, body)) Show("current", body);
            _current = body;
        }
        _checkMs = sw.Elapsed.TotalMilliseconds;
        StateHasChanged();
    }

    private async Task ForecastLaterAsync(int version, int delayMs)
    {
        await Task.Delay(delayMs);
        if (version != _forecastVersion || !_viewerReady) return;
        if (_observedEndpoint is not null) return;

        var forecast = RunForecasts();
        _fitForecast ??= _fitCurrent?.Clone();
        var watch = Stopwatch.StartNew();
        var muscle = _personalized.Display?.Muscle;
        var shapeProfile = forecast.End;
        if (muscle is not null && _personalized.Display is { } snapshot)
        {
            var point = snapshot.Expected[ShapeWeek];
            shapeProfile = snapshot.StartProfile();
            shapeProfile.WeightKg = point.Body.WeightKg; shapeProfile.BodyFatPercent = point.Body.FatPercent;
            foreach (var (g, cm) in point.Girths) shapeProfile.SetGirth(g, cm);
        }
        IBodyShape body = UseMakeHuman
            ? BuildMakeHuman(shapeProfile, ref _fitForecast, fitVolume: true,
                muscle: _exercise.Atlas is not null ? muscle?.Weeks[ShapeWeek].Morph : null,
                muscleGeometry:_personalized.Display?.MuscleGeometry)
            : Mannequin.Build(shapeProfile);
        Show("forecast", body);
        _forecastBody = body;
        Console.WriteLine($"Forecast MakeHuman rebuild: {watch.Elapsed.TotalMilliseconds:F1} ms, muscle={muscle is not null}");
        ApplyForecastHeatmap();
        StateHasChanged();
    }

    /// <summary>
    /// Новые прогнозы — от текущего профиля и актуальной калибровки; выбранная архивная версия
    /// воспроизводится из сохранённых точек. Расчёт не изменяет историю или фактический профиль.
    /// </summary>
    private ForecastResult RunForecasts()
    {
        var timing = Stopwatch.StartNew();
        var now = DateTimeOffset.Now;
        var today = DateOnly.FromDateTime(now.Date);
        var startFact = _history.Timeline.Selected is { } selected && selected.Date == today ? selected :
            _history.Timeline.Items.LastOrDefault(s => s.Date == today && s.WeightKg.HasValue) ?? _history.Timeline.Items.LastOrDefault(s => s.Date == today);
        var commonStart = _profile.Clone();
        if (startFact is not null)
        {
            if (startFact.WeightKg is { } kg) commonStart.WeightKg = kg;
            if (startFact.BodyFatPercent is { } bf) commonStart.BodyFatPercent = bf;
            foreach (var (g, value) in startFact.Measurements) commonStart.SetGirth(g, value.Cm);
        }
        var chosen = _hypotheses.Current;
        var chosenResult = _personalized.Calculate(_profile, chosen.Plan.ToInput(), now, $"slot:{chosen.Slot}", chosen.Name, startFact, _strength.Sessions, _history.Timeline.Items);
        var forecasts = new List<HypothesisForecast>();
        foreach (var h in _hypotheses.Items)
        {
            try
            {
                var result = h.Slot == _hypotheses.Selected ? chosenResult : h.Plan.Strength && h.Plan.StrengthProgram is not null
                    ? ForecastSnapshot.Create(_profile, h.Plan.ToInput(), today, now, _personalized.CurrentRevision, startFact,
                        strengthHistory: _strength.Sessions, bodyHistory: _history.Timeline.Items, previousForecasts: _personalized.Archive.Forecasts).Replay()
                    : ForecastEngine.Run(commonStart, h.Plan.ToInput(), _personalized.CurrentRevision?.Profile);
                forecasts.Add(new(h, result));
            }
            catch (ArgumentException e) { _personalized.ReportError($"План «{h.Name}» исключён из сравнения: {e.Message}"); }
        }
        _forecasts = forecasts;
        _personalized.Evaluate(_history.Timeline.Items, today);
        _forecastMs = timing.Elapsed.TotalMilliseconds;
        Console.WriteLine($"Product timing: forecast {_forecastMs:F2} ms, muscle={_personalized.Display?.Muscle is not null}");
        return _forecast = (_forecasts.FirstOrDefault(f => f.Hypothesis.Slot == _hypotheses.Selected) ?? _forecasts[0]).Forecast;
    }
}
