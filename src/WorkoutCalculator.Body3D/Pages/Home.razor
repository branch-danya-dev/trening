@using System.Diagnostics

<div class="app">
    <header class="topbar">
        <span class="brand-dot"></span>
        <span class="brand">Модель тела</span>
        <span class="brand-sub">прототип: манекен по замерам и прогноз изменений</span>
    </header>

    <div class="main">
        <section class="viewport" aria-label="3D-модель">
            <canvas id="body-canvas" tabindex="0"></canvas>

            <div class="view-toolbar">
                <button class="btn" @onclick='() => ViewerInterop.SetView("front")'>Спереди</button>
                <button class="btn" @onclick='() => ViewerInterop.SetView("side")'>Сбоку</button>
                <button class="btn" @onclick='() => ViewerInterop.SetView("back")'>Сзади</button>
                <button class="btn" @onclick='() => ViewerInterop.SetView("reset")'>Сброс камеры</button>
            </div>

            @if (_mode == ViewMode.Compare && _forecast is not null)
            {
                @if (_sideBySide)
                {
                    <div class="view-labels"><span>Сейчас</span><span>Прогноз</span></div>
                }
                else
                {
                    <div class="legend">
                        <span class="now">Сейчас (силуэт)</span>
                        <span class="later">Через @_forecast.Weeks[^1].Week нед.</span>
                    </div>
                }
            }

            <div class="mode-bar">
                <div class="seg" role="group" aria-label="Что показать">
                    <button class="@Css.On(_mode == ViewMode.Current)" @onclick="() => SetMode(ViewMode.Current)">Сейчас</button>
                    <button class="@Css.On(_mode == ViewMode.Forecast)" disabled="@(_forecast is null)"
                            @onclick="() => SetMode(ViewMode.Forecast)">Прогноз</button>
                    <button class="@Css.On(_mode == ViewMode.Compare)" disabled="@(_forecast is null)"
                            @onclick="() => SetMode(ViewMode.Compare)">Сравнение</button>
                </div>
                @if (_mode == ViewMode.Compare)
                {
                    <label class="check">
                        <input type="checkbox" checked="@_sideBySide" @onchange="ToggleSideBySide" /> рядом
                    </label>
                }
            </div>

            @if (_current is not null)
            {
                <div class="view-stats">
                    @Mannequin.Segments точек на сечение · @Fmt.N(_current.Mesh.VertexCount) вершин ·
                    сетка @Fmt.N(_buildMs) мс + передача @Fmt.N(_uploadMs) мс · объём @Fmt.N(_volumeMs) мс
                </div>
            }
        </section>

        <aside class="panel">
            <nav class="tabs" role="tablist">
                <button role="tab" class="@Css.On(_tab == Tab.Params)" @onclick="() => _tab = Tab.Params">Параметры</button>
                <button role="tab" class="@Css.On(_tab == Tab.Hypothesis)" @onclick="OpenHypothesis">Гипотеза</button>
            </nav>

            <div class="panel-body">
                @if (_tab == Tab.Params)
                {
                    <ProfilePanel Profile="_profile" Report="_report" OnChange="ChangeProfile" />
                }
                else
                {
                    <HypothesisPanel Profile="_profile" Hypothesis="_hypothesis" Forecast="_forecast" OnChange="ChangeHypothesis" />
                }
            </div>
        </aside>
    </div>
</div>

@code {
    private enum Tab { Params, Hypothesis }
    private enum ViewMode { Current, Forecast, Compare }

    private BodyProfile _profile = BodyDefaults.Default();
    private StoredHypothesis _hypothesis = new();
    private Mannequin? _current;
    private ConsistencyReport? _report;
    private ForecastResult? _forecast;

    private Tab _tab = Tab.Params;
    private ViewMode _mode = ViewMode.Current;
    private bool _sideBySide;

    private bool _viewerReady;
    private bool _dirty;
    private bool _rebuilding;
    private double _buildMs;
    private double _uploadMs;
    private double _volumeMs;

    /// <summary>Объём и проверка дороже сетки — считаем, когда ползунок отпустили.</summary>
    private const int CheckDelayMs = 150;
    /// <summary>Прогноз пересчитывается после паузы во вводе.</summary>
    private const int ForecastDelayMs = 200;
    private int _checkVersion;
    private int _forecastVersion;

    protected override void OnInitialized()
    {
        _profile = ProfileStorage.LoadProfile() ?? BodyDefaults.Default();
        _hypothesis = ProfileStorage.LoadHypothesis() ?? DefaultHypothesis(_profile);
    }

    /// <summary>По умолчанию — умеренный дефицит 400 ккал от текущего расхода.</summary>
    private static StoredHypothesis DefaultHypothesis(BodyProfile p)
    {
        var h = new StoredHypothesis();
        double maintenance = ForecastEngine.Expenditure(p, p.WeightKg, h.ToInput()).Total;
        h.IntakeKcalPerDay = Math.Round((maintenance - 400) / 50) * 50;
        return h;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        ViewerInterop.Init("body-canvas");
        _viewerReady = true;
        RequestRebuild();
        _ = ForecastLaterAsync(++_forecastVersion, 0);
    }

    private void ChangeProfile(Action<BodyProfile> change)
    {
        change(_profile);
        ProfileStorage.SaveProfile(_profile);
        RequestRebuild();
        _ = ForecastLaterAsync(++_forecastVersion, ForecastDelayMs);
    }

    private void ChangeHypothesis(Action<StoredHypothesis> change)
    {
        change(_hypothesis);
        ProfileStorage.SaveHypothesis(_hypothesis);
        _ = ForecastLaterAsync(++_forecastVersion, ForecastDelayMs);
    }

    private void OpenHypothesis()
    {
        _tab = Tab.Hypothesis;
        if (_mode == ViewMode.Current && _forecast is not null)
            SetMode(ViewMode.Compare); // на вкладке гипотез сразу видно разницу
    }

    private void SetMode(ViewMode mode)
    {
        _mode = mode;
        ApplyMode();
    }

    private void ToggleSideBySide(ChangeEventArgs e)
    {
        _sideBySide = e.Value is true;
        ApplyMode();
    }

    private void ApplyMode()
    {
        string mode = _mode switch
        {
            ViewMode.Forecast => "forecast",
            ViewMode.Compare => "compare",
            _ => "current",
        };
        ViewerInterop.SetMode(mode, _sideBySide);
    }

    /// <summary>
    /// Перестройка не чаще, чем успевает: пока строится сетка, новые значения ползунков только
    /// запоминаются, и следующий проход берёт самые свежие.
    /// </summary>
    private void RequestRebuild()
    {
        _dirty = true;
        if (_viewerReady && !_rebuilding)
            _ = RebuildLoopAsync();
    }

    private async Task RebuildLoopAsync()
    {
        _rebuilding = true;
        try
        {
            while (_dirty)
            {
                _dirty = false;
                var sw = Stopwatch.StartNew();
                var model = Mannequin.Build(_profile.Clone());
                _buildMs = sw.Elapsed.TotalMilliseconds;
                sw.Restart();
                ViewerInterop.SetMesh("current", model.Mesh);
                _uploadMs = sw.Elapsed.TotalMilliseconds;

                _current = model;
                _ = CheckLaterAsync(model, ++_checkVersion);
                StateHasChanged();
                await Task.Delay(1); // отдать управление браузеру: кадр и новые события ползунка
            }
        }
        finally
        {
            _rebuilding = false;
        }
    }

    private async Task CheckLaterAsync(Mannequin model, int version)
    {
        await Task.Delay(CheckDelayMs);
        if (version != _checkVersion) return; // ползунок ещё двигают
        var sw = Stopwatch.StartNew();
        _report = ConsistencyChecker.Check(model);
        _volumeMs = sw.Elapsed.TotalMilliseconds;
        StateHasChanged();
    }

    private async Task ForecastLaterAsync(int version, int delayMs)
    {
        await Task.Delay(delayMs);
        if (version != _forecastVersion || !_viewerReady) return;

        _forecast = ForecastEngine.Run(_profile.Clone(), _hypothesis.ToInput());
        ViewerInterop.SetMesh("forecast", Mannequin.Build(_forecast.End).Mesh);
        StateHasChanged();
    }
}
