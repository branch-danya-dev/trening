@* График веса по неделям: одна линия, перекрестие с подсказкой (мышь и стрелки), цель — тонкая линия. *@
<div class="chart">
    <svg viewBox="0 0 @W @H" role="img" aria-label="@AriaLabel" tabindex="0"
         @onkeydown="OnKey" @onpointerleave="() => _hover = null" @onblur="() => _hover = null">
        @foreach (var t in _yTicks)
        {
            <g>
                <line class="grid" x1="@F(Left)" x2="@F(W - Right)" y1="@F(Y(t))" y2="@F(Y(t))" />
                <text class="tick" x="@F(Left - 6)" y="@F(Y(t) + 3.5)" text-anchor="end">@Fmt.N(t, _yDecimals)</text>
            </g>
        }
        @foreach (int w in _xTicks)
        {
            <g><text class="tick" x="@F(X(w))" y="@F(H - 6)" text-anchor="middle">@w</text></g>
        }

        @if (Target is double target && target >= _yMin && target <= _yMax)
        {
            <g>
                <line class="target" x1="@F(Left)" x2="@F(W - Right)" y1="@F(Y(target))" y2="@F(Y(target))" />
                <text class="tick" x="@F(Left + 4)" y="@F(Y(target) - 4)">цель @Fmt.N(target, 1) кг</text>
            </g>
        }

        <path class="line" d="@_path" />
        <circle class="dot" cx="@F(X(0))" cy="@F(Y(Weeks[0].WeightKg))" r="4" />
        <circle class="dot" cx="@F(X(_last))" cy="@F(Y(Weeks[_last].WeightKg))" r="4" />
        <text class="end-label" x="@F(X(_last))" y="@F(EndLabelY())" text-anchor="end">@Fmt.N(Weeks[_last].WeightKg, 1) кг</text>

        @if (_hover is int i)
        {
            var wk = Weeks[i];
            double x = X(i);
            bool flip = x > Left + PlotW * 0.6;
            double bx = flip ? x - 8 - TipW : x + 8;
            <line class="crosshair" x1="@F(x)" x2="@F(x)" y1="@F(Top)" y2="@F(Top + PlotH)" />
            <circle class="dot" cx="@F(x)" cy="@F(Y(wk.WeightKg))" r="4" />
            <g class="tip">
                <rect x="@F(bx)" y="@F(Top + 2)" width="@TipW" height="46" rx="6" />
                <text class="tip-value" x="@F(bx + 8)" y="@F(Top + 19)">@Fmt.N(wk.WeightKg, 1) кг</text>
                <text class="tip-label" x="@F(bx + 8)" y="@F(Top + 33)">неделя @wk.Week · жир @Fmt.N(wk.FatPercent, 1) %</text>
                <text class="tip-label" x="@F(bx + 8)" y="@F(Top + 44)">баланс @Fmt.Signed(wk.BalanceKcalPerDay, 0) ккал/день</text>
            </g>
        }

        @* Зоны наведения шире линии: каждая неделя — полоса во всю высоту *@
        @for (int w = 0; w <= _last; w++)
        {
            int week = w;
            double half = PlotW / Math.Max(1, _last) / 2;
            <rect class="hit" x="@F(X(week) - half)" y="@F(Top)" width="@F(2 * half)" height="@F(PlotH)"
                  @onpointerenter="() => _hover = week" @onpointermove="() => _hover = week" />
        }
    </svg>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ForecastWeek> Weeks { get; set; } = [];
    [Parameter] public double? Target { get; set; }

    private const double W = 360, H = 176, Left = 34, Right = 14, Top = 10, Bottom = 22, TipW = 150;
    private const double PlotW = W - Left - Right, PlotH = H - Top - Bottom;

    private int? _hover;
    private int _last;
    private double _yMin, _yMax;
    private int _yDecimals;
    private List<double> _yTicks = [];
    private List<int> _xTicks = [];
    private string _path = "";

    private string AriaLabel => Weeks.Count == 0 ? "" :
        $"Вес по неделям: с {Fmt.N(Weeks[0].WeightKg, 1)} до {Fmt.N(Weeks[^1].WeightKg, 1)} кг за {_last} нед.";

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private double X(int week) => Left + (_last == 0 ? 0 : PlotW * week / _last);
    private double Y(double kg) => Top + PlotH * (1 - (kg - _yMin) / (_yMax - _yMin));

    /// <summary>Подпись конца над точкой, а если линия идёт вверх к краю — под ней.</summary>
    private double EndLabelY()
    {
        double y = Y(Weeks[_last].WeightKg);
        return y - 10 < Top + 8 ? y + 16 : y - 10;
    }

    protected override void OnParametersSet()
    {
        _last = Math.Max(0, Weeks.Count - 1);
        if (_hover > _last) _hover = null;

        // Ось Y: «круглые» деления, не больше 4–5 штук
        double min = Weeks.Min(w => w.WeightKg), max = Weeks.Max(w => w.WeightKg);
        if (Target is double t)
        {
            min = Math.Min(min, t);
            max = Math.Max(max, t);
        }
        double span = Math.Max(max - min, 0.4);
        double step = new[] { 0.2, 0.5, 1, 2, 5, 10, 20 }.First(s => span / s <= 4);
        _yMin = Math.Floor((min - span * 0.05) / step) * step;
        _yMax = Math.Ceiling((max + span * 0.05) / step) * step;
        _yDecimals = step < 1 ? 1 : 0;
        _yTicks = [];
        for (double v = _yMin; v <= _yMax + step / 2; v += step)
            _yTicks.Add(Math.Round(v, 2));

        int xStep = new[] { 1, 2, 4, 8, 13, 26 }.First(s => _last / (double)s <= 6);
        _xTicks = [];
        for (int w = 0; w <= _last; w += xStep)
            _xTicks.Add(w);

        _path = string.Join(" ", Weeks.Select((w, i) => $"{(i == 0 ? "M" : "L")}{F(X(i))},{F(Y(w.WeightKg))}"));
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowRight") _hover = Math.Min(_last, (_hover ?? -1) + 1);
        else if (e.Key == "ArrowLeft") _hover = Math.Max(0, (_hover ?? _last + 1) - 1);
    }
}
